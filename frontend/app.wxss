/* ui-ux-pro-max v5 · "MUJI 无印良品"
 * 风格: 极简 / 克制 / 安静 / 自然 / 留白 / 朴素
 * 颜色: 米白 + 暖灰 + 原木 + 深灰 (低饱和自然色)
 * 避免: 渐变 / 强阴影 / 大圆角 / 大量 Card / 巨大数字 / Emoji / 科技感
 * 字体: -apple-system / PingFang SC (wx 不支持 web font, MUJI 本身只用 Helvetica + 自家字体)
 * 原则: Less is More · 内容优先 · 留白本身就是设计
 * 8 状态: default · hover · focus-visible · active · disabled · loading · error · success
 */

/* ============ Color tokens (MUJI — 低饱和自然色) ============ */
page {
  /* Surfaces — 纸张感米白 */
  --color-bg:          #F8F5EE;   /* 主背景 — 米白 */
  --color-bg-2:        #F2EEE5;   /* 次级表面 */
  --color-bg-3:        #EBE5D8;   /* 凹陷 (输入框) */
  --color-bg-elevated: #F8F5EE;

  /* Text — 深灰 (不是纯黑) */
  --color-fg:          #3A3A3A;   /* 主文字 — 深灰 */
  --color-fg-2:        #6B6B6B;   /* 次文字 */
  --color-fg-3:        #9E9E9E;   /* 提示 */
  --color-fg-4:        #C4C4C4;   /* 占位 */

  /* Brand: 原木色 (只有一个 accent, 不抢眼) */
  --color-primary:     #8B7355;   /* 原木棕 */
  --color-primary-2:   #75603F;   /* hover */
  --color-primary-3:   #A89274;   /* 浅 */
  --color-on-primary:  #FFFFFF;

  /* Borders — 1px 极细 hairline */
  --color-border:      #E8E2D5;   /* 极淡米色 */
  --color-border-2:    #F0EAD9;
  --color-rule:        rgba(58, 58, 58, 0.08);

  /* Status — 全部低饱和 */
  --color-error:       #B85A4A;   /* 砖红 */
  --color-error-soft:  #F7E8E3;
  --color-success:     #6B8265;   /* 橄榄绿 */
  --color-success-soft:#E8EFE5;
  --color-warning:     #C89669;   /* 浅琥珀 */
  --color-warning-soft:#F5EBDF;

  /* 分类色 — 全部低饱和自然色 (MUJI palette) */
  --cat-food:          #C89669;   /* 餐饮 - 浅琥珀 */
  --cat-transport:     #8B9DAF;   /* 交通 - 灰蓝 */
  --cat-shop:          #A0937D;   /* 购物 - 暖灰褐 */
  --cat-home:          #A8A29E;   /* 居家 - 米灰 */
  --cat-fun:           #9B8AAD;   /* 娱乐 - 淡紫 */
  --cat-medical:       #B89B8B;   /* 医疗 - 玫瑰灰 */
  --cat-income:        #7D9988;   /* 工资 - 鼠尾草绿 */
  --cat-other:         #9E9E9E;   /* 其他 - 中灰 */

  background-color: var(--color-bg);
  color: var(--color-fg);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  line-height: 1.55;
}

/* ============ Typography (克制 — 不巨大) ============ */
page {
  --font-display: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  --font-body:    -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  --font-mono:    "SF Mono", "Menlo", "Courier New", monospace;

  --text-xs:  22rpx;
  --text-sm:  26rpx;
  --text-md:  28rpx;
  --text-lg:  32rpx;
  --text-xl:  40rpx;

  --leading-tight:  1.2;
  --leading-normal: 1.55;
  --leading-loose:  1.7;

  --tracking-tight:  -0.01em;
  --tracking-normal: 0;
  --tracking-wide:   0.02em;
}

/* ============ Spacing (8pt 主导, 更大间距) ============ */
page {
  --space-1:  8rpx;
  --space-2:  16rpx;
  --space-3:  24rpx;
  --space-4:  32rpx;
  --space-5:  48rpx;
  --space-6:  64rpx;
  --space-7:  96rpx;
  --space-8:  128rpx;
}

/* ============ Radius (克制的 4-8px) ============ */
page {
  --radius-sm:  4rpx;
  --radius-md:  6rpx;
  --radius-lg:  8rpx;
  --radius-pill: 999rpx;

  --border-thin:  1rpx solid var(--color-border);
  --border-thick: 2rpx solid var(--color-primary);
}

/* ============ Motion (极轻 — 100-200ms) ============ */
page {
  --dur-fast: 120ms;
  --dur-base: 180ms;
  --dur-slow: 240ms;
  --ease-out:    cubic-bezier(0.16, 1, 0.3, 1);
  --ease-in:     cubic-bezier(0.4, 0, 1, 1);
  --ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);
}

/* ============ Shadow (极少用) ============ */
page {
  --shadow-none: none;
  --shadow-sm: 0 1rpx 2rpx rgba(58, 58, 58, 0.04);
}

/* ============ Layout utils ============ */
.row { display: flex; flex-direction: row; align-items: center; }
.col { display: flex; flex-direction: column; }
.between { justify-content: space-between; }
.center { justify-content: center; align-items: center; }
.gap-1 { gap: var(--space-1); }
.gap-2 { gap: var(--space-2); }
.gap-3 { gap: var(--space-3); }
.gap-4 { gap: var(--space-4); }
.gap-5 { gap: var(--space-5); }
.flex-1 { flex: 1; min-width: 0; }

/* ============ Type utils (克制 — 不巨大) ============ */
.h1 { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 500; line-height: var(--leading-tight); letter-spacing: var(--tracking-tight); color: var(--color-fg); }
.h2 { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 500; line-height: var(--leading-tight); color: var(--color-fg); }
.h3 { font-family: var(--font-display); font-size: var(--text-md); font-weight: 500; color: var(--color-fg); }
.h4 { font-family: var(--font-display); font-size: var(--text-sm); font-weight: 500; color: var(--color-fg); }
.label { font-family: var(--font-body); font-size: var(--text-xs); font-weight: 400; color: var(--color-fg-2); letter-spacing: 0.02em; }
.mono { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
.muted { color: var(--color-fg-2); }
.dim { color: var(--color-fg-3); }
.ink { color: var(--color-fg); }
.primary { color: var(--color-primary); }
.accent { color: var(--color-success); }
.error { color: var(--color-error); }
.amount-md { font-family: var(--font-mono); font-size: var(--text-lg); font-weight: 400; color: var(--color-fg); letter-spacing: -0.01em; font-variant-numeric: tabular-nums; }
.amount-sm { font-family: var(--font-mono); font-size: var(--text-md); font-weight: 400; color: var(--color-fg); font-variant-numeric: tabular-nums; }

/* ============ Card (极淡) ============ */
.card {
  background: var(--color-bg-2);
  border: var(--border-thin);
  border-radius: var(--radius-md);
  padding: var(--space-4);
  box-shadow: var(--shadow-none);
}
.card--hover { background: var(--color-bg-3); }

/* ============ Button (8 states) ============ */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  padding: 0 var(--space-4);
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-family: var(--font-display);
  font-size: var(--text-md);
  font-weight: 500;
  border: 1rpx solid var(--color-primary);
  border-radius: var(--radius-md);
  transition: background-color var(--dur-base) var(--ease-out);
  cursor: pointer;
}
.btn:hover, .btn.is-hover { background: var(--color-primary-2); border-color: var(--color-primary-2); }
.btn:focus-visible, .btn.is-focus { outline: 2rpx solid var(--color-primary); outline-offset: 2rpx; }
.btn:active, .btn.is-active { background: var(--color-primary-2); }
.btn[disabled], .btn.is-disabled, .btn:disabled { background: var(--color-bg-3); color: var(--color-fg-3); border-color: transparent; cursor: not-allowed; }
.btn.is-loading { opacity: 0.5; pointer-events: none; }
.btn.is-error { background: var(--color-error); border-color: var(--color-error); }
.btn.is-success { background: var(--color-success); border-color: var(--color-success); }

/* Ghost (主要按钮, MUJI 偏好的低调) */
.btn--ghost {
  background: transparent;
  color: var(--color-fg);
  border: 1rpx solid var(--color-border);
}
.btn--ghost:hover, .btn--ghost.is-hover { background: var(--color-bg-2); border-color: var(--color-fg-3); }
.btn--ghost:focus-visible { outline: 2rpx solid var(--color-primary); outline-offset: 2rpx; }

/* Text-only (MUJI 风格的主 CTA 文字按钮) */
.btn--text {
  background: transparent;
  color: var(--color-primary);
  border: none;
  text-decoration: underline;
  text-underline-offset: 6rpx;
  min-height: auto;
  padding: 0;
}
.btn--text:hover, .btn--text.is-hover { color: var(--color-primary-2); }

/* Danger */
.btn--danger {
  background: transparent;
  color: var(--color-error);
  border: 1rpx solid var(--color-error);
}
.btn--danger:hover, .btn--danger.is-hover { background: var(--color-error); color: var(--color-on-primary); }

/* ============ Input (无 border, 极简) ============ */
.input {
  min-height: 72rpx;
  padding: 0 var(--space-3);
  background: transparent;
  color: var(--color-fg);
  font-family: var(--font-mono);
  font-size: var(--text-md);
  font-variant-numeric: tabular-nums;
  border: none;
  border-bottom: 1rpx solid var(--color-border);
  border-radius: 0;
  box-sizing: border-box;
  transition: border-color var(--dur-base) var(--ease-out);
}
.input::placeholder { color: var(--color-fg-3); }
.input:hover, .input.is-hover { border-bottom-color: var(--color-fg-3); }
.input:focus, .input.is-focus { border-bottom-color: var(--color-primary); outline: none; }
.input[disabled] { color: var(--color-fg-3); }
.input.is-error { border-bottom-color: var(--color-error); }
.input.is-success { border-bottom-color: var(--color-success); }

.textarea {
  min-height: 100rpx;
  padding: var(--space-2) 0;
  background: transparent;
  color: var(--color-fg);
  font-family: var(--font-body);
  font-size: var(--text-md);
  border: none;
  border-bottom: 1rpx solid var(--color-border);
  border-radius: 0;
  box-sizing: border-box;
  line-height: var(--leading-normal);
  transition: border-color var(--dur-base) var(--ease-out);
}
.textarea:focus, .textarea.is-focus { border-bottom-color: var(--color-primary); outline: none; }

/* ============ 分类色 (text-only 风格, 无背景块) ============ */
.chip {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  font-size: var(--text-xs);
  font-weight: 400;
  color: var(--color-fg-2);
  padding: 0;
}
.chip__dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--color-fg-3);
  flex-shrink: 0;
}
.chip--food      .chip__dot, .cat-food      { color: var(--cat-food); }
.chip--transport .chip__dot, .cat-transport { color: var(--cat-transport); }
.chip--shop      .chip__dot, .cat-shop      { color: var(--cat-shop); }
.chip--home      .chip__dot, .cat-home      { color: var(--cat-home); }
.chip--fun       .chip__dot, .cat-fun       { color: var(--cat-fun); }
.chip--medical   .chip__dot, .cat-medical   { color: var(--cat-medical); }
.chip--income    .chip__dot, .cat-income    { color: var(--cat-income); }
.chip--other     .chip__dot, .cat-other     { color: var(--cat-other); }
.chip--food      .chip__dot { background: var(--cat-food); }
.chip--transport .chip__dot { background: var(--cat-transport); }
.chip--shop      .chip__dot { background: var(--cat-shop); }
.chip--home      .chip__dot { background: var(--cat-home); }
.chip--fun       .chip__dot { background: var(--cat-fun); }
.chip--medical   .chip__dot { background: var(--cat-medical); }
.chip--income    .chip__dot { background: var(--cat-income); }
.chip--other     .chip__dot { background: var(--cat-other); }

/* ============ Empty state ============ */
.empty {
  padding: var(--space-7) var(--space-4);
  text-align: center;
}
.empty__title { font-size: var(--text-md); font-weight: 500; color: var(--color-fg); margin-bottom: var(--space-2); }
.empty__hint { font-size: var(--text-sm); color: var(--color-fg-2); margin-bottom: var(--space-4); }

/* ============ State bars ============ */
.state-bar {
  padding: var(--space-2) var(--space-3);
  font-size: var(--text-sm);
  color: var(--color-fg-2);
  border-radius: var(--radius-sm);
  text-align: center;
  margin-bottom: var(--space-3);
}
.state-bar--error { color: var(--color-error); background: var(--color-error-soft); }
.state-bar--loading { color: var(--color-fg-2); background: var(--color-bg-2); }
.state-bar--success { color: var(--color-success); background: var(--color-success-soft); }

/* ============ Hairline (MUJI 偏好的极细线) ============ */
.hairline { height: 1rpx; background: var(--color-border); margin: var(--space-4) 0; }
.hairline--thick { height: 1rpx; background: var(--color-fg); margin: var(--space-4) 0; }

/* ============ Progress bar (极淡) ============ */
.bar-track {
  width: 100%;
  height: 2rpx;
  background: var(--color-border);
  border-radius: 0;
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  background: var(--color-primary);
  transition: width var(--dur-slow) var(--ease-out);
}

/* ============ Reduced motion ============ */
@media (prefers-reduced-motion: reduce) {
  view, text, button, image, input, textarea, scroll-view {
    transition: none !important;
    animation: none !important;
  }
}
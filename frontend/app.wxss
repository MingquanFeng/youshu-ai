/* ui-ux-pro-max v6 · "Modern Soft 现代柔和"
 * 风格: 柔和 / 圆润 / 层次 / 友好 / 现代
 * 颜色: 暖白底 + 现代翠绿 (emerald) + 暖珊瑚强调 (rose) + 低饱和分类色
 * 圆角: 14-20rpx (卡片 20rpx, 按钮 14rpx, FAB 28rpx)
 * 阴影: Soft UI Evolution — 多层柔和阴影 (0.06-0.10 alpha)
 * 动画: 200-300ms ease-out, 重点元素 spring 感
 * 字体: -apple-system / PingFang SC (wx 不支持 web font)
 * 原则: 柔而克制 · 卡片分层 · 微动效让界面活起来 · 内容优先
 */

/* ============ Color tokens (Modern Soft — 暖白底 + 翠绿主色) ============ */
page {
  /* Surfaces — 暖白纸张感 */
  --color-bg:          #FAF8F5;   /* 主背景 — 暖米白 */
  --color-bg-2:        #FFFFFF;   /* 卡片表面 — 纯白 */
  --color-bg-3:        #F4F1ED;   /* 凹陷 / 输入框 */
  --color-bg-warm:     #FFF7F0;   /* 暖色高亮 (Top/advice) */
  --color-bg-elevated: #FFFFFF;

  /* Text — slate 系 */
  --color-fg:          #1F2937;   /* 主文字 — slate-800 */
  --color-fg-2:        #6B7280;   /* 次文字 — slate-500 */
  --color-fg-3:        #9CA3AF;   /* 提示 — slate-400 */
  --color-fg-4:        #D1D5DB;   /* 占位 — slate-300 */

  /* Primary — 现代翠绿 (emerald-500), 主 CTA */
  --color-primary:     #10B981;
  --color-primary-2:   #059669;   /* hover / pressed */
  --color-primary-3:   #34D399;   /* 浅色 / 装饰 */
  --color-primary-soft:#D1FAE5;   /* 主色背景 (浅绿) */
  --color-on-primary:  #FFFFFF;

  /* Accent — 暖珊瑚 (rose-400), 强调 / Top / 重要数据 */
  --color-accent:      #FB7185;
  --color-accent-2:    #F43F5E;
  --color-accent-soft: #FFE4E6;

  /* Borders — 极淡 hairline */
  --color-border:      #E7E3DC;   /* 暖灰 hairline */
  --color-border-2:    #F0ECE5;
  --color-rule:        rgba(31, 41, 55, 0.06);

  /* Status — 中等饱和 (Soft UI 调色板) */
  --color-error:       #EF4444;
  --color-error-soft:  #FEE2E2;
  --color-success:     #10B981;
  --color-success-soft:#D1FAE5;
  --color-warning:     #F59E0B;
  --color-warning-soft:#FEF3C7;

  /* 分类色 — 保留语义, 略微提亮 (Soft UI Evolution) */
  --cat-food-soft:      rgba(251, 146, 60, 0.14);    /* 餐饮 - 暖橙 */
  --cat-transport-soft: rgba(56, 189, 248, 0.16);    /* 交通 - 天蓝 */
  --cat-shop-soft:      rgba(244, 114, 182, 0.14);   /* 购物 - 粉 */
  --cat-home-soft:      rgba(148, 163, 184, 0.20);   /* 居家 - 冷灰 */
  --cat-fun-soft:       rgba(167, 139, 250, 0.16);   /* 娱乐 - 紫 */
  --cat-medical-soft:   rgba(248, 113, 113, 0.14);   /* 医疗 - 玫瑰 */
  --cat-income-soft:    rgba(16, 185, 129, 0.16);    /* 工资 - 绿 */
  --cat-other-soft:     rgba(156, 163, 175, 0.14);   /* 其他 - 灰 */

  --cat-food:          #F59E0B;   /* 餐饮 - amber-500 */
  --cat-transport:     #38BDF8;   /* 交通 - sky-400 */
  --cat-shop:          #F472B6;   /* 购物 - pink-400 */
  --cat-home:          #94A3B8;   /* 居家 - slate-400 */
  --cat-fun:           #A78BFA;   /* 娱乐 - violet-400 */
  --cat-medical:       #F87171;   /* 医疗 - red-400 */
  --cat-income:        #10B981;   /* 工资 - emerald-500 */
  --cat-other:         #9CA3AF;   /* 其他 - gray-400 */

  background-color: var(--color-bg);
  color: var(--color-fg);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  line-height: 1.55;
}

/* ============ Typography (现代 — 数字更大、字重更柔) ============ */
page {
  --font-display: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  --font-body:    -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  --font-mono:    "SF Mono", "Menlo", "Courier New", monospace;

  --text-xs:  22rpx;
  --text-sm:  26rpx;
  --text-md:  28rpx;
  --text-lg:  34rpx;
  --text-xl:  44rpx;

  --leading-tight:  1.2;
  --leading-normal: 1.55;
  --leading-loose:  1.7;

  --tracking-tight:  -0.01em;
  --tracking-normal: 0;
  --tracking-wide:   0.02em;
}

/* ============ Spacing (8pt 主导, 更大呼吸) ============ */
page {
  --space-1:  8rpx;
  --space-2:  16rpx;
  --space-3:  24rpx;
  --space-4:  32rpx;
  --space-5:  48rpx;
  --space-6:  64rpx;
  --space-7:  96rpx;
  --space-8:  128rpx;
}

/* ============ Radius (现代 — 14-28rpx 系统化) ============ */
page {
  --radius-sm:  8rpx;
  --radius-md:  14rpx;
  --radius-lg:  20rpx;
  --radius-xl:  28rpx;
  --radius-pill: 999rpx;

  --border-thin:  1rpx solid var(--color-border);
}

/* ============ Motion (200-300ms, 重点 spring) ============ */
page {
  --dur-fast: 160ms;
  --dur-base: 220ms;
  --dur-slow: 320ms;
  --dur-spring: 380ms;
  --ease-out:    cubic-bezier(0.16, 1, 0.3, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --ease-in:     cubic-bezier(0.4, 0, 1, 1);
  --ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);
}

/* ============ Shadow (Soft UI Evolution — 多层柔和) ============ */
page {
  --shadow-none: none;
  --shadow-sm:  0 1rpx 3rpx rgba(15, 23, 42, 0.06), 0 1rpx 2rpx rgba(15, 23, 42, 0.04);
  --shadow-md:  0 4rpx 12rpx rgba(15, 23, 42, 0.08), 0 2rpx 4rpx rgba(15, 23, 42, 0.04);
  --shadow-lg:  0 10rpx 32rpx rgba(15, 23, 42, 0.10), 0 4rpx 10rpx rgba(15, 23, 42, 0.06);
  --shadow-fab: 0 8rpx 24rpx rgba(16, 185, 129, 0.32), 0 2rpx 6rpx rgba(16, 185, 129, 0.18);
  --shadow-press: 0 2rpx 8rpx rgba(15, 23, 42, 0.06);
}

/* ============ Layout utils ============ */
.row { display: flex; flex-direction: row; align-items: center; }
.col { display: flex; flex-direction: column; }
.between { justify-content: space-between; }
.center { justify-content: center; align-items: center; }
.gap-1 { gap: var(--space-1); }
.gap-2 { gap: var(--space-2); }
.gap-3 { gap: var(--space-3); }
.gap-4 { gap: var(--space-4); }
.gap-5 { gap: var(--space-5); }
.flex-1 { flex: 1; min-width: 0; }

/* ============ Type utils (现代 — 字重更柔) ============ */
.h1 { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 600; line-height: var(--leading-tight); letter-spacing: var(--tracking-tight); color: var(--color-fg); }
.h2 { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 600; line-height: var(--leading-tight); color: var(--color-fg); }
.h3 { font-family: var(--font-display); font-size: var(--text-md); font-weight: 500; color: var(--color-fg); }
.h4 { font-family: var(--font-display); font-size: var(--text-sm); font-weight: 500; color: var(--color-fg); }
.label { font-family: var(--font-body); font-size: var(--text-xs); font-weight: 400; color: var(--color-fg-2); letter-spacing: 0.02em; }
.mono { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
.muted { color: var(--color-fg-2); }
.dim { color: var(--color-fg-3); }
.ink { color: var(--color-fg); }
.primary { color: var(--color-primary); }
.accent { color: var(--color-accent); }
.error { color: var(--color-error); }
.amount-md { font-family: var(--font-mono); font-size: var(--text-lg); font-weight: 500; color: var(--color-fg); letter-spacing: -0.01em; font-variant-numeric: tabular-nums; }
.amount-sm { font-family: var(--font-mono); font-size: var(--text-md); font-weight: 500; color: var(--color-fg); font-variant-numeric: tabular-nums; }

/* ============ Card (柔和阴影 + 20rpx 圆角) ============ */
.card {
  background: var(--color-bg-2);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  box-shadow: var(--shadow-sm);
  transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
}
.card--hover { background: var(--color-bg-2); box-shadow: var(--shadow-md); transform: translateY(-2rpx); }

/* ============ Button (8 states) ============ */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 var(--space-5);
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-family: var(--font-display);
  font-size: var(--text-md);
  font-weight: 500;
  border: none;
  border-radius: var(--radius-md);
  box-shadow: 0 2rpx 6rpx rgba(16, 185, 129, 0.20);
  transition: background-color var(--dur-base) var(--ease-out),
              box-shadow var(--dur-base) var(--ease-out),
              transform var(--dur-base) var(--ease-out);
  cursor: pointer;
}
.btn:hover, .btn.is-hover { background: var(--color-primary-2); box-shadow: 0 4rpx 10rpx rgba(16, 185, 129, 0.26); }
.btn:focus-visible, .btn.is-focus { outline: 3rpx solid var(--color-primary); outline-offset: 2rpx; }
.btn:active, .btn.is-active { background: var(--color-primary-2); transform: scale(0.98); box-shadow: var(--shadow-press); }
.btn[disabled], .btn.is-disabled, .btn:disabled { background: var(--color-bg-3); color: var(--color-fg-3); border-color: transparent; box-shadow: none; cursor: not-allowed; }
.btn.is-loading { opacity: 0.7; pointer-events: none; }
.btn.is-error { background: var(--color-error); border-color: var(--color-error); }
.btn.is-success { background: var(--color-success); border-color: var(--color-success); }

/* Ghost (次要按钮) */
.btn--ghost {
  background: var(--color-bg-2);
  color: var(--color-fg);
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-sm);
}
.btn--ghost:hover, .btn--ghost.is-hover { background: var(--color-bg); border-color: var(--color-fg-3); box-shadow: var(--shadow-md); }
.btn--ghost:focus-visible { outline: 3rpx solid var(--color-primary); outline-offset: 2rpx; }
.btn--ghost:active { transform: scale(0.98); }

/* Text-only */
.btn--text {
  background: transparent;
  color: var(--color-primary);
  border: none;
  font-weight: 500;
  min-height: auto;
  padding: 0;
  box-shadow: none;
}
.btn--text:hover, .btn--text.is-hover { color: var(--color-primary-2); }

/* Danger */
.btn--danger {
  background: var(--color-bg-2);
  color: var(--color-error);
  border: 1rpx solid var(--color-error-soft);
  box-shadow: var(--shadow-sm);
}
.btn--danger:hover, .btn--danger.is-hover { background: var(--color-error-soft); border-color: var(--color-error); }

/* ============ Input (柔和 — 圆角 + 阴影) ============ */
.input {
  min-height: 80rpx;
  padding: 0 var(--space-3);
  background: var(--color-bg-2);
  color: var(--color-fg);
  font-family: var(--font-mono);
  font-size: var(--text-md);
  font-variant-numeric: tabular-nums;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  box-sizing: border-box;
  transition: border-color var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
}
.input::placeholder { color: var(--color-fg-3); }
.input:hover, .input.is-hover { border-color: var(--color-fg-3); }
.input:focus, .input.is-focus { border-color: var(--color-primary); box-shadow: 0 0 0 4rpx rgba(16, 185, 129, 0.12); outline: none; }
.input[disabled] { color: var(--color-fg-3); background: var(--color-bg-3); }
.input.is-error { border-color: var(--color-error); }
.input.is-success { border-color: var(--color-success); }

.textarea {
  min-height: 100rpx;
  padding: var(--space-3);
  background: var(--color-bg-2);
  color: var(--color-fg);
  font-family: var(--font-body);
  font-size: var(--text-md);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  box-sizing: border-box;
  line-height: var(--leading-normal);
  transition: border-color var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
}
.textarea:focus, .textarea.is-focus { border-color: var(--color-primary); box-shadow: 0 0 0 4rpx rgba(16, 185, 129, 0.12); outline: none; }

/* ============ Chip (圆角 pill + 柔和底色) ============ */
.chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: var(--text-xs);
  font-weight: 500;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-pill);
  background: var(--color-bg-3);
  color: var(--color-fg-2);
  transition: background-color var(--dur-fast) var(--ease-out);
}
.chip__dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--color-fg-3);
  flex-shrink: 0;
}
.chip--food      { background: var(--cat-food-soft); color: var(--cat-food); }
.chip--transport { background: var(--cat-transport-soft); color: var(--cat-transport); }
.chip--shop      { background: var(--cat-shop-soft); color: var(--cat-shop); }
.chip--home      { background: var(--cat-home-soft); color: var(--color-fg); }
.chip--fun       { background: var(--cat-fun-soft); color: var(--cat-fun); }
.chip--medical   { background: var(--cat-medical-soft); color: var(--cat-medical); }
.chip--income    { background: var(--cat-income-soft); color: var(--cat-income); }
.chip--other     { background: var(--cat-other-soft); color: var(--color-fg-2); }
.chip--high      { background: var(--color-success-soft); color: var(--color-success); }
.chip--mid       { background: var(--color-warning-soft); color: var(--color-warning); }
.chip--low       { background: var(--color-error-soft); color: var(--color-error); }

.chip--food      .chip__dot { background: var(--cat-food); }
.chip--transport .chip__dot { background: var(--cat-transport); }
.chip--shop      .chip__dot { background: var(--cat-shop); }
.chip--home      .chip__dot { background: var(--cat-home); }
.chip--fun       .chip__dot { background: var(--cat-fun); }
.chip--medical   .chip__dot { background: var(--cat-medical); }
.chip--income    .chip__dot { background: var(--cat-income); }
.chip--other     .chip__dot { background: var(--cat-other); }

/* 分类文字色 (兼容旧用法) */
.cat-food      { color: var(--cat-food); }
.cat-transport { color: var(--cat-transport); }
.cat-shop      { color: var(--cat-shop); }
.cat-home      { color: var(--cat-home); }
.cat-fun       { color: var(--cat-fun); }
.cat-medical   { color: var(--cat-medical); }
.cat-income    { color: var(--cat-income); }
.cat-other     { color: var(--cat-other); }

/* ============ Empty state ============ */
.empty {
  padding: var(--space-7) var(--space-4);
  text-align: center;
}
.empty__title { font-size: var(--text-md); font-weight: 500; color: var(--color-fg); margin-bottom: var(--space-2); }
.empty__hint { font-size: var(--text-sm); color: var(--color-fg-2); margin-bottom: var(--space-4); }

/* ============ State bars (圆角 + 柔色) ============ */
.state-bar {
  padding: var(--space-3);
  font-size: var(--text-sm);
  color: var(--color-fg-2);
  border-radius: var(--radius-md);
  text-align: center;
  margin-bottom: var(--space-3);
}
.state-bar--error { color: var(--color-error); background: var(--color-error-soft); }
.state-bar--loading { color: var(--color-primary); background: var(--color-primary-soft); }
.state-bar--success { color: var(--color-success); background: var(--color-success-soft); }

/* ============ Hairline ============ */
.hairline { height: 1rpx; background: var(--color-border); margin: var(--space-4) 0; }
.hairline--thick { height: 1rpx; background: var(--color-fg); margin: var(--space-4) 0; }

/* ============ Progress bar (柔和) ============ */
.bar-track {
  width: 100%;
  height: 8rpx;
  background: var(--color-bg-3);
  border-radius: var(--radius-pill);
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  background: var(--color-primary);
  border-radius: var(--radius-pill);
  transition: width var(--dur-slow) var(--ease-out);
}

/* ============ 公共 tab bar (4 tabs, 提到全局, 三个页面复用) ============ */
.tabbar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: saturate(180%) blur(20rpx);
  -webkit-backdrop-filter: saturate(180%) blur(20rpx);
  border-top: 1rpx solid var(--color-border-2);
  display: flex;
  padding: var(--space-2) var(--space-2) calc(var(--space-2) + env(safe-area-inset-bottom));
  z-index: 100;
}
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: var(--space-1) 0;
  color: var(--color-fg-3);
  transition: color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  position: relative;
}
.tab__icon {
  font-size: 36rpx;
  line-height: 1;
  transition: transform var(--dur-base) var(--ease-spring);
}
.tab__label {
  font-size: 20rpx;
  font-weight: 400;
}
.tab:active .tab__icon { transform: scale(0.92); }
.tab--active { color: var(--color-fg); }
.tab--active .tab__label { font-weight: 500; }
.tab--active .tab__icon { color: var(--color-primary); transform: scale(1.05); }

/* ============ 公共 FAB (浮动主 CTA) ============ */
.fab {
  position: fixed;
  right: 36rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-fab);
  transition: transform var(--dur-base) var(--ease-spring),
              box-shadow var(--dur-base) var(--ease-out),
              background-color var(--dur-base) var(--ease-out);
  z-index: 101;
}
.fab--hover { transform: scale(0.94); box-shadow: 0 4rpx 14rpx rgba(16, 185, 129, 0.34); }
.fab:active { background: var(--color-primary-2); }
.fab__icon {
  font-size: 64rpx;
  font-weight: 300;
  line-height: 1;
  color: var(--color-on-primary);
}

/* ============ 公共 stat / section / txn / amount-card 容器 ============ */
.stat {
  background: var(--color-bg-2);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  margin-bottom: var(--space-5);
  box-shadow: var(--shadow-sm);
  transition: box-shadow var(--dur-base) var(--ease-out);
  min-width: 0;
  overflow: visible;
}
.stat .label { margin-bottom: 4rpx; }

.section {
  background: var(--color-bg-2);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-3) var(--space-4);
  box-shadow: var(--shadow-sm);
  margin-bottom: var(--space-5);
  transition: box-shadow var(--dur-base) var(--ease-out);
}
.section-head {
  padding: var(--space-2) 0 var(--space-3);
}

.txn {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) 0;
  transition: opacity var(--dur-fast) var(--ease-out);
}
.txn:active, .txn--hover { opacity: 0.6; }

.txn__icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--cat-other-soft);
  transition: transform var(--dur-base) var(--ease-spring);
}
.txn:active .txn__icon { transform: scale(0.92); }
.txn__icon-char {
  font-family: var(--font-display);
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-fg);
  line-height: 1;
}
.txn__col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.txn .amount-sm {
  font-weight: 500;
  color: var(--color-fg);
}

.amount-card {
  background: var(--color-bg-2);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  margin-bottom: var(--space-4);
  box-shadow: var(--shadow-sm);
}
.amount-card .amount-md {
  font-family: var(--font-mono);
  color: var(--color-primary);
  font-variant-numeric: tabular-nums;
  line-height: 1;
}

.form-card {
  background: var(--color-bg-2);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4) var(--space-5);
  margin-bottom: var(--space-5);
  box-shadow: var(--shadow-sm);
}
.form-card .label { margin-bottom: var(--space-3); }
.form-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-2) 0;
  border-bottom: 1rpx solid var(--color-border-2);
}
.form-row:last-child { border-bottom: none; }
.form-row--top { align-items: flex-start; }
.form-label {
  width: 100rpx;
  flex-shrink: 0;
  color: var(--color-fg-2);
  font-size: var(--text-sm);
}
.form-row .input,
.form-row .textarea {
  flex: 1;
  min-width: 0;
  border: none;
  box-shadow: none;
  background: transparent;
  border-radius: 0;
}
.form-row .input:focus,
.form-row .textarea:focus {
  box-shadow: none;
  border: none;
}
.form-row .textarea {
  min-height: 80rpx;
}

.actions {
  display: flex;
  gap: var(--space-3);
  margin-top: var(--space-3);
}
.actions .btn { flex: 1; min-width: 0; }

/* ============ 顶部导航区 ============ */
.topbar {
  margin-bottom: var(--space-5);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}
.topbar__title {
  font-size: var(--text-xl);
  font-weight: 600;
  color: var(--color-fg);
  letter-spacing: var(--tracking-tight);
}
.topbar__greeting {
  font-size: var(--text-xl);
  font-weight: 600;
  color: var(--color-fg);
  letter-spacing: var(--tracking-tight);
}
.topbar__month {
  font-size: var(--text-xl);
  font-weight: 600;
  color: var(--color-fg);
  letter-spacing: var(--tracking-tight);
}
.topbar__icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--cat-other-soft);
  box-shadow: var(--shadow-sm);
}
.topbar__icon-char {
  font-family: var(--font-display);
  font-size: 38rpx;
  font-weight: 500;
  color: var(--color-fg);
  line-height: 1;
}
.topbar__merchant {
  font-size: var(--text-lg);
  font-weight: 600;
  color: var(--color-fg);
  line-height: var(--leading-tight);
  margin-bottom: 2rpx;
}

/* ============ Page wrapper ============ */
.page {
  min-height: 100vh;
  background: var(--color-bg);
  color: var(--color-fg);
  position: relative;
}
.page--with-tabbar { padding: var(--space-5) var(--space-5) 220rpx; }
.page--with-foot  { padding: var(--space-5) var(--space-5) var(--space-7); }

/* ============ Skeleton (加载骨架, shimmer 动画) ============ */
@keyframes skel-shimmer {
  0%   { background-position: -200rpx 0; }
  100% { background-position: 200rpx 0; }
}
.skel {
  display: block;
  background: linear-gradient(
    90deg,
    var(--color-bg-3) 0%,
    var(--color-bg-2) 50%,
    var(--color-bg-3) 100%
  );
  background-size: 400rpx 100%;
  border-radius: var(--radius-sm);
  animation: skel-shimmer 1.6s ease-in-out infinite;
}
.skel--block {
  height: 200rpx;
  border-radius: var(--radius-md);
}
.skel--lg {
  height: 36rpx;
}
.skel--md {
  height: 24rpx;
}
.skel--sm {
  height: 18rpx;
  width: 60%;
}
.skel--circle {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}
.skel-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) 0;
}
.skel-row__col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  min-width: 0;
}
.skel-row__amount {
  width: 120rpx;
  height: 28rpx;
}
@media (prefers-reduced-motion: reduce) {
  .skel { animation: none; background: var(--color-bg-3); }
}

/* ============ Reduced motion ============ */
@media (prefers-reduced-motion: reduce) {
  view, text, button, image, input, textarea, scroll-view {
    transition: none !important;
    animation: none !important;
  }
}
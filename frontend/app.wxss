/* Hallmark × ui-ux-pro-max · v2.0
 * Design system: Accessible & Ethical / Minimal Single Column
 * Theme: Dark (primary) — background #0F172A (slate-900)
 * Typography: Plus Jakarta Sans → system-ui / -apple-system / PingFang SC fallback (wx 小程序无 web font)
 * Pattern: 大标题 + 单一 CTA + 大量留白 + 单列布局
 * Iconography: 纯文字 + monospace 数字 (wx 不支持 SVG icon 库，原生 view/text)
 * Contrast: 全部 color tokens 满足 4.5:1 (AAA)
 * Touch: 所有交互元素 ≥44pt
 * Motion: 150-300ms 缓动，预留 reduced-motion
 * 状态: default · hover · focus-visible · active · disabled · loading · error · success
 */

/* ============ Color tokens (Dark theme, AAA contrast) ============ */
page {
  /* Surfaces */
  --color-bg:            #0F172A;  /* slate-900, 主背景 */
  --color-bg-2:          #1E293B;  /* slate-800, 次级表面（卡背景） */
  --color-bg-3:          #334155;  /* slate-700, 凹陷/输入 */
  --color-bg-elevated:   #1E293B;  /* 浮动元素 */

  /* Text */
  --color-fg:            #F8FAFC;  /* slate-50, 主文字 (12:1 极高对比) */
  --color-fg-2:          #CBD5E1;  /* slate-300, 次文字 (8:1) */
  --color-fg-3:          #94A3B8;  /* slate-400, 提示 (5.5:1) */
  --color-fg-4:          #64748B;  /* slate-500, 占位 (3.5:1 边缘) */

  /* Brand: 信任蓝 */
  --color-primary:       #1E40AF;  /* blue-800, 主色 */
  --color-primary-2:     #1D4ED8;  /* hover */
  --color-primary-3:     #2563EB;  /* active / 浅 */
  --color-on-primary:    #FFFFFF;  /* 主色上的文字 */

  /* Accent: 利润绿 (用于"已识别" / "已保存" / Top 类目) */
  --color-accent:        #059669;  /* emerald-600 */
  --color-accent-2:      #10B981;  /* hover */
  --color-accent-soft:   #064E3B;  /* emerald-900, 背景态 */

  /* Status */
  --color-error:         #DC2626;  /* red-600 */
  --color-error-soft:    #7F1D1D;  /* 背景态 */
  --color-warning:       #F59E0B;  /* amber-500 */
  --color-success:       #10B981;  /* 同 accent */

  /* Borders / Dividers */
  --color-border:        #334155;  /* slate-700, 主边框 */
  --color-border-2:      rgba(248, 250, 252, 0.08);  /* 极淡 */
  --color-rule:          rgba(248, 250, 252, 0.06);  /* 分割线 */

  background-color: var(--color-bg);
  color: var(--color-fg);
  font-size: 28rpx;
  font-family: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  line-height: 1.5;
}

/* ============ Typography tokens ============ */
page {
  --font-display: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  --font-body:    -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  --font-mono:    "SF Mono", "Menlo", "Courier New", monospace;

  --text-xs:  20rpx;
  --text-sm:  24rpx;
  --text-md:  28rpx;
  --text-lg:  32rpx;
  --text-xl:  40rpx;
  --text-2xl: 56rpx;
  --text-3xl: 72rpx;
  --text-4xl: 96rpx;

  --leading-tight:  1.15;
  --leading-normal: 1.5;
  --leading-loose:  1.65;

  --tracking-tight:  -0.03em;
  --tracking-normal: 0;
  --tracking-wide:   0.05em;
}

/* ============ Spacing tokens (4pt scale) ============ */
page {
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 48rpx;
  --space-6: 64rpx;
  --space-7: 96rpx;
  --space-8: 128rpx;
}

/* ============ Border / Radius tokens ============ */
page {
  --radius-sm:  8rpx;
  --radius-md:  12rpx;
  --radius-lg:  16rpx;
  --radius-xl:  24rpx;
  --radius-pill: 999rpx;

  --border-thin:  1rpx solid var(--color-border);
  --border-thick: 2rpx solid var(--color-primary);
}

/* ============ Motion tokens (150-300ms) ============ */
page {
  --dur-fast: 150ms;
  --dur-base: 200ms;
  --dur-slow: 300ms;
  --ease-out:    cubic-bezier(0.16, 1, 0.3, 1);
  --ease-in:     cubic-bezier(0.4, 0, 1, 1);
  --ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);
}

/* ============ Shadow (dark mode elevation) ============ */
page {
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.24);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.32);
  --shadow-lg: 0 8rpx 32rpx rgba(0, 0, 0, 0.40);
}

/* ============ Layout utilities ============ */
.row { display: flex; flex-direction: row; align-items: center; }
.col { display: flex; flex-direction: column; }
.between { justify-content: space-between; }
.center { justify-content: center; align-items: center; }
.gap-1 { gap: var(--space-1); }
.gap-2 { gap: var(--space-2); }
.gap-3 { gap: var(--space-3); }
.gap-4 { gap: var(--space-4); }
.gap-5 { gap: var(--space-5); }
.flex-1 { flex: 1; min-width: 0; }

/* ============ Typography utilities ============ */
.h1 { font-family: var(--font-display); font-size: var(--text-3xl); font-weight: 700; line-height: var(--leading-tight); letter-spacing: var(--tracking-tight); color: var(--color-fg); }
.h2 { font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 700; line-height: var(--leading-tight); color: var(--color-fg); }
.h3 { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 600; line-height: var(--leading-normal); color: var(--color-fg); }
.h4 { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 600; color: var(--color-fg); }
.label-sm { font-family: var(--font-body); font-size: var(--text-xs); font-weight: 500; color: var(--color-fg-3); letter-spacing: var(--tracking-wide); text-transform: uppercase; }
.mono { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
.muted { color: var(--color-fg-3); }
.dim { color: var(--color-fg-2); }
.ink { color: var(--color-fg); }
.primary { color: var(--color-primary-3); }
.accent { color: var(--color-accent-2); }
.error { color: var(--color-error); }
.amount-xl { font-family: var(--font-mono); font-size: var(--text-3xl); font-weight: 700; color: var(--color-fg); letter-spacing: -0.02em; line-height: 1; font-variant-numeric: tabular-nums; }
.amount-lg { font-family: var(--font-mono); font-size: var(--text-2xl); font-weight: 600; color: var(--color-fg); letter-spacing: -0.02em; line-height: 1; font-variant-numeric: tabular-nums; }

/* ============ Card / Surface (dark mode elevation) ============ */
.card {
  background: var(--color-bg-2);
  border: var(--border-thin);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  box-shadow: var(--shadow-sm);
}
.card--primary {
  background: var(--color-primary);
  border: none;
  box-shadow: var(--shadow-md);
}
.card--accent {
  background: var(--color-accent-soft);
  border: 1rpx solid var(--color-accent);
}
.card--hover { background: var(--color-bg-3); border-color: var(--color-primary); }

/* ============ Button (8 states, AAA contrast) ============ */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 var(--space-5);
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-family: var(--font-display);
  font-size: var(--text-md);
  font-weight: 600;
  border: none;
  border-radius: var(--radius-md);
  transition: background-color var(--dur-base) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  cursor: pointer;
}
.btn:hover, .btn.is-hover { background: var(--color-primary-2); }
.btn:focus-visible, .btn.is-focus { outline: 3rpx solid var(--color-accent-2); outline-offset: 2rpx; }
.btn:active, .btn.is-active { background: var(--color-primary-3); transform: scale(0.98); }
.btn[disabled], .btn.is-disabled, .btn:disabled { background: var(--color-bg-3); color: var(--color-fg-4); cursor: not-allowed; }
.btn.is-loading { opacity: 0.6; pointer-events: none; }
.btn.is-loading::after { content: " …"; }
.btn.is-error { background: var(--color-error); }
.btn.is-success { background: var(--color-accent); }

/* Ghost */
.btn--ghost {
  background: transparent;
  color: var(--color-fg);
  border: 1rpx solid var(--color-border);
}
.btn--ghost:hover, .btn--ghost.is-hover { background: var(--color-bg-2); border-color: var(--color-fg-3); }
.btn--ghost:focus-visible { outline: 3rpx solid var(--color-accent-2); outline-offset: 2rpx; }
.btn--ghost:active, .btn--ghost.is-active { background: var(--color-bg-3); transform: scale(0.98); }
.btn--ghost[disabled] { color: var(--color-fg-4); border-color: var(--color-border); }

/* Danger */
.btn--danger {
  background: transparent;
  color: var(--color-error);
  border: 1rpx solid var(--color-error);
}
.btn--danger:hover, .btn--danger.is-hover { background: var(--color-error); color: var(--color-on-primary); }
.btn--danger:focus-visible { outline: 3rpx solid var(--color-error); outline-offset: 2rpx; }

/* ============ Input (8 states, dark) ============ */
.input {
  min-height: 88rpx;
  padding: 0 var(--space-3);
  background: var(--color-bg-3);
  color: var(--color-fg);
  font-family: var(--font-mono);
  font-size: var(--text-md);
  font-variant-numeric: tabular-nums;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  box-sizing: border-box;
  transition: border-color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);
}
.input::placeholder { color: var(--color-fg-4); }
.input:hover, .input.is-hover { border-color: var(--color-fg-3); }
.input:focus, .input.is-focus { border-color: var(--color-primary-3); background: var(--color-bg-2); outline: none; }
.input[disabled] { background: var(--color-bg-2); color: var(--color-fg-4); border-color: var(--color-border); }
.input.is-error { border-color: var(--color-error); background: var(--color-error-soft); }
.input.is-success { border-color: var(--color-accent); }

.textarea {
  min-height: 144rpx;
  padding: var(--space-3);
  background: var(--color-bg-3);
  color: var(--color-fg);
  font-family: var(--font-body);
  font-size: var(--text-md);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  box-sizing: border-box;
  line-height: var(--leading-normal);
  transition: border-color var(--dur-base) var(--ease-out);
}
.textarea:focus, .textarea.is-focus { border-color: var(--color-primary-3); background: var(--color-bg-2); outline: none; }

/* ============ Chip (tag) ============ */
.chip {
  display: inline-flex;
  align-items: center;
  height: 36rpx;
  padding: 0 var(--space-2);
  background: var(--color-bg-3);
  color: var(--color-fg-2);
  font-family: var(--font-body);
  font-size: var(--text-xs);
  font-weight: 500;
  letter-spacing: 0.04em;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-pill);
}
.chip--accent { background: var(--color-accent-soft); color: var(--color-accent-2); border-color: var(--color-accent); }
.chip--primary { background: var(--color-primary); color: var(--color-on-primary); border-color: var(--color-primary); }
.chip--success { background: var(--color-accent-soft); color: var(--color-accent-2); border-color: var(--color-accent); }

/* ============ Empty state ============ */
.empty {
  padding: var(--space-7) var(--space-4);
  text-align: center;
}
.empty__title { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 600; color: var(--color-fg); margin-bottom: var(--space-2); }
.empty__hint { font-size: var(--text-sm); color: var(--color-fg-3); margin-bottom: var(--space-4); }

/* ============ State bars (loading / error / success) ============ */
.state-bar {
  padding: var(--space-2) var(--space-3);
  font-family: var(--font-body);
  font-size: var(--text-sm);
  font-weight: 500;
  border: 1rpx solid;
  border-radius: var(--radius-md);
  text-align: center;
}
.state-bar--error { color: var(--color-error); border-color: var(--color-error); background: var(--color-error-soft); }
.state-bar--loading { color: var(--color-fg-3); border-color: var(--color-border); background: var(--color-bg-2); }
.state-bar--success { color: var(--color-accent-2); border-color: var(--color-accent); background: var(--color-accent-soft); }

/* ============ Hairline divider ============ */
.hairline { height: 1rpx; background: var(--color-rule); margin: var(--space-3) 0; }
.hairline--thick { height: 2rpx; background: var(--color-fg-3); margin: var(--space-4) 0; }

/* ============ Progress / bar ============ */
.bar-track {
  width: 100%;
  height: 8rpx;
  background: var(--color-bg-3);
  border-radius: var(--radius-pill);
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  background: var(--color-primary-3);
  border-radius: var(--radius-pill);
  transition: width var(--dur-slow) var(--ease-out);
}
.bar-fill--accent { background: var(--color-accent-2); }

/* ============ Reduced motion (mandatory) ============ */
@media (prefers-reduced-motion: reduce) {
  view, text, button, image, input, textarea, scroll-view {
    transition: none !important;
    animation: none !important;
  }
}
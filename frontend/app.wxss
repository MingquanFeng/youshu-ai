/* ui-ux-pro-max v4 · "焦橙+奶油"
 * 配色: 焦橙主色 #FF6B35 + 淡奶油背景 #FFF8F0
 * 风格: 温暖年轻 + 强分类对比 + 高密度
 * Typography: -apple-system / PingFang SC (wx 小程序无 web font)
 * 8 状态: default · hover · focus-visible · active · disabled · loading · error · success
 */

/* ============ Color tokens (焦橙 + 奶油) ============ */
page {
  /* Surfaces */
  --color-bg:          #FFF8F0;   /* 淡奶油, 主背景 */
  --color-bg-2:        #FFFFFF;   /* 卡片白底 */
  --color-bg-3:        #F5EFE0;   /* 凹陷（输入框底） */
  --color-bg-elevated: #FFFFFF;
  --color-bg-warm:     #FFE8D6;   /* 暖色提示背景 */

  /* Text */
  --color-fg:          #1A1A1A;   /* 主文字 (近黑) */
  --color-fg-2:        #6B6B6B;   /* 次文字 */
  --color-fg-3:        #A8A8A8;   /* 提示 */
  --color-fg-4:        #D4D4D4;   /* 占位 */

  /* Brand: 焦橙 */
  --color-primary:     #FF6B35;   /* 焦橙-600 */
  --color-primary-2:   #E55A2B;   /* hover */
  --color-primary-3:   #FF8A5C;   /* active / 浅 */
  --color-on-primary:  #FFFFFF;

  /* Borders */
  --color-border:      #F0E6D2;   /* 奶米色 hairline */
  --color-border-2:    #FAEEDC;
  --color-rule:        rgba(26, 26, 26, 0.06);

  /* Status */
  --color-error:       #D32F2F;   /* 深红 */
  --color-error-soft:  #FFEBEE;
  --color-success:     #00897B;   /* 森绿 */
  --color-success-soft:#E0F2F1;
  --color-warning:     #F57C00;
  --color-warning-soft:#FFF3E0;

  /* Category palette (6 高对比色 + 2 辅助) */
  --cat-food:          #FF6B35;   /* 餐饮 - 焦橙 (主色复用) */
  --cat-transport:     #1A1A1A;   /* 交通 - 纯黑 (对比) */
  --cat-shop:          #E91E63;   /* 购物 - 品红 */
  --cat-home:          #FFD600;   /* 居家 - 柠檬黄 */
  --cat-fun:           #6B3FA0;   /* 娱乐 - 深紫 */
  --cat-medical:       #D32F2F;   /* 医疗 - 深红 */
  --cat-income:        #00897B;   /* 工资 - 森绿 */
  --cat-other:         #9E9E9E;   /* 其他 - 灰 */

  background-color: var(--color-bg);
  color: var(--color-fg);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  line-height: 1.5;
}

/* ============ Typography ============ */
page {
  --font-display: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  --font-body:    -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  --font-mono:    "SF Mono", "Menlo", "Courier New", monospace;

  --text-xs:  20rpx;
  --text-sm:  22rpx;
  --text-md:  26rpx;
  --text-lg:  32rpx;
  --text-xl:  40rpx;
  --text-2xl: 56rpx;
  --text-3xl: 72rpx;

  --leading-tight:  1.15;
  --leading-normal: 1.45;
  --leading-loose:  1.65;

  --tracking-tight:  -0.02em;
  --tracking-normal: 0;
  --tracking-wide:   0.05em;
}

/* ============ Spacing (4pt) ============ */
page {
  --space-1:  8rpx;
  --space-2:  12rpx;
  --space-3:  16rpx;
  --space-4:  20rpx;
  --space-5:  28rpx;
  --space-6:  40rpx;
  --space-7:  64rpx;
}

/* ============ Border / Radius ============ */
page {
  --radius-sm:  8rpx;
  --radius-md:  12rpx;
  --radius-lg:  16rpx;
  --radius-xl:  20rpx;
  --radius-pill: 999rpx;

  --border-thin:  1rpx solid var(--color-border);
  --border-thick: 2rpx solid var(--color-primary);
}

/* ============ Motion (150-300ms) ============ */
page {
  --dur-fast: 150ms;
  --dur-base: 200ms;
  --dur-slow: 300ms;
  --ease-out:    cubic-bezier(0.16, 1, 0.3, 1);
  --ease-in:     cubic-bezier(0.4, 0, 1, 1);
  --ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);
}

/* ============ Shadow ============ */
page {
  --shadow-sm: 0 1rpx 2rpx rgba(255, 107, 53, 0.06);
  --shadow-md: 0 2rpx 8rpx rgba(255, 107, 53, 0.10);
  --shadow-lg: 0 4rpx 16rpx rgba(255, 107, 53, 0.14);
}

/* ============ Layout utils ============ */
.row { display: flex; flex-direction: row; align-items: center; }
.col { display: flex; flex-direction: column; }
.between { justify-content: space-between; }
.center { justify-content: center; align-items: center; }
.gap-1 { gap: var(--space-1); }
.gap-2 { gap: var(--space-2); }
.gap-3 { gap: var(--space-3); }
.gap-4 { gap: var(--space-4); }
.gap-5 { gap: var(--space-5); }
.flex-1 { flex: 1; min-width: 0; }

/* ============ Type utils ============ */
.h1 { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 700; line-height: var(--leading-tight); letter-spacing: var(--tracking-tight); color: var(--color-fg); }
.h2 { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 700; line-height: var(--leading-tight); color: var(--color-fg); }
.h3 { font-family: var(--font-display); font-size: var(--text-md); font-weight: 600; color: var(--color-fg); }
.h4 { font-family: var(--font-display); font-size: var(--text-sm); font-weight: 600; color: var(--color-fg); }
.label { font-family: var(--font-body); font-size: var(--text-xs); font-weight: 500; color: var(--color-fg-2); letter-spacing: var(--tracking-wide); }
.mono { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
.muted { color: var(--color-fg-2); }
.dim { color: var(--color-fg-3); }
.ink { color: var(--color-fg); }
.primary { color: var(--color-primary); }
.accent { color: var(--color-success); }
.error { color: var(--color-error); }
.amount-xl { font-family: var(--font-mono); font-size: var(--text-2xl); font-weight: 700; color: var(--color-fg); letter-spacing: -0.02em; line-height: 1; font-variant-numeric: tabular-nums; }
.amount-lg { font-family: var(--font-mono); font-size: var(--text-xl); font-weight: 700; color: var(--color-fg); letter-spacing: -0.02em; line-height: 1; font-variant-numeric: tabular-nums; }
.amount-md { font-family: var(--font-mono); font-size: var(--text-lg); font-weight: 700; color: var(--color-fg); letter-spacing: -0.02em; line-height: 1; font-variant-numeric: tabular-nums; }
.amount-sm { font-family: var(--font-mono); font-size: var(--text-md); font-weight: 600; color: var(--color-fg); font-variant-numeric: tabular-nums; }

/* ============ Card ============ */
.card {
  background: var(--color-bg-2);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  box-shadow: var(--shadow-sm);
}
.card--primary {
  background: var(--color-primary);
  border: none;
  color: var(--color-on-primary);
  box-shadow: var(--shadow-md);
}
.card--primary .label,
.card--primary .muted { color: rgba(255, 255, 255, 0.85); }
.card--warm { background: var(--color-bg-warm); border-color: rgba(255, 107, 53, 0.18); }
.card--hover { background: var(--color-bg-3); border-color: var(--color-primary); }

/* ============ Button (8 states) ============ */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 var(--space-5);
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-family: var(--font-display);
  font-size: var(--text-md);
  font-weight: 600;
  border: none;
  border-radius: var(--radius-md);
  transition: background-color var(--dur-base) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  cursor: pointer;
}
.btn:hover, .btn.is-hover { background: var(--color-primary-2); }
.btn:focus-visible, .btn.is-focus { outline: 3rpx solid var(--color-primary-3); outline-offset: 2rpx; }
.btn:active, .btn.is-active { background: var(--color-primary-2); transform: scale(0.98); }
.btn[disabled], .btn.is-disabled, .btn:disabled { background: var(--color-bg-3); color: var(--color-fg-3); cursor: not-allowed; }
.btn.is-loading { opacity: 0.6; pointer-events: none; }
.btn.is-loading::after { content: " …"; }
.btn.is-error { background: var(--color-error); }
.btn.is-success { background: var(--color-success); }
.btn--pill { border-radius: var(--radius-pill); min-height: 96rpx; font-size: var(--text-lg); }

.btn--ghost {
  background: var(--color-bg-2);
  color: var(--color-fg);
  border: 1rpx solid var(--color-border);
}
.btn--ghost:hover, .btn--ghost.is-hover { background: var(--color-bg-3); border-color: var(--color-primary); }
.btn--ghost:focus-visible { outline: 3rpx solid var(--color-primary); outline-offset: 2rpx; }
.btn--ghost[disabled] { color: var(--color-fg-3); }

.btn--danger {
  background: var(--color-bg-2);
  color: var(--color-error);
  border: 1rpx solid var(--color-error);
}
.btn--danger:hover, .btn--danger.is-hover { background: var(--color-error); color: var(--color-on-primary); }

/* ============ Input ============ */
.input {
  min-height: 80rpx;
  padding: 0 var(--space-3);
  background: var(--color-bg-3);
  color: var(--color-fg);
  font-family: var(--font-mono);
  font-size: var(--text-md);
  font-variant-numeric: tabular-nums;
  border: 1rpx solid transparent;
  border-radius: var(--radius-md);
  box-sizing: border-box;
  transition: border-color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);
}
.input::placeholder { color: var(--color-fg-3); }
.input:hover, .input.is-hover { border-color: var(--color-border); }
.input:focus, .input.is-focus { border-color: var(--color-primary); background: var(--color-bg-2); outline: none; }
.input[disabled] { background: var(--color-border); color: var(--color-fg-3); }
.input.is-error { border-color: var(--color-error); background: var(--color-error-soft); }
.input.is-success { border-color: var(--color-success); }

.textarea {
  min-height: 120rpx;
  padding: var(--space-3);
  background: var(--color-bg-3);
  color: var(--color-fg);
  font-family: var(--font-body);
  font-size: var(--text-md);
  border: 1rpx solid transparent;
  border-radius: var(--radius-md);
  box-sizing: border-box;
  line-height: var(--leading-normal);
  transition: border-color var(--dur-base) var(--ease-out);
}
.textarea:focus, .textarea.is-focus { border-color: var(--color-primary); background: var(--color-bg-2); outline: none; }

/* ============ Chip + 分类色 ============ */
.chip {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  height: 32rpx;
  padding: 0 var(--space-2);
  font-size: var(--text-xs);
  font-weight: 500;
  border-radius: var(--radius-pill);
  background: var(--color-bg-3);
  color: var(--color-fg-2);
}
.chip__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-fg-3);
  flex-shrink: 0;
}
.chip--food      .chip__dot, .cat-food      { background: var(--cat-food); }
.chip--transport .chip__dot, .cat-transport { background: var(--cat-transport); }
.chip--shop      .chip__dot, .cat-shop      { background: var(--cat-shop); }
.chip--home      .chip__dot, .cat-home      { background: var(--cat-home); }
.chip--fun       .chip__dot, .cat-fun       { background: var(--cat-fun); }
.chip--medical   .chip__dot, .cat-medical   { background: var(--cat-medical); }
.chip--income    .chip__dot, .cat-income    { background: var(--cat-income); }
.chip--other     .chip__dot, .cat-other     { background: var(--cat-other); }

.chip--food      { background: rgba(255, 107, 53, 0.12); color: var(--cat-food); }
.chip--transport { background: rgba(26, 26, 26, 0.08); color: var(--cat-transport); }
.chip--shop      { background: rgba(233, 30, 99, 0.10); color: var(--cat-shop); }
.chip--home      { background: rgba(255, 214, 0, 0.20); color: #B45309; }
.chip--fun       { background: rgba(107, 63, 160, 0.12); color: var(--cat-fun); }
.chip--medical   { background: rgba(211, 47, 47, 0.10); color: var(--cat-medical); }
.chip--income    { background: rgba(0, 137, 123, 0.12); color: #00695C; }
.chip--other     { background: var(--color-bg-3); color: var(--color-fg-2); }

/* ============ Category 色块（卡片/列表左侧） ============ */
.cat-stripe {
  width: 4rpx;
  align-self: stretch;
  border-radius: 2rpx;
  flex-shrink: 0;
}

/* ============ Empty state ============ */
.empty {
  padding: var(--space-7) var(--space-4);
  text-align: center;
}
.empty__icon {
  font-size: 64rpx;
  color: var(--color-fg-3);
  margin-bottom: var(--space-3);
}
.empty__title { font-size: var(--text-md); font-weight: 600; color: var(--color-fg); margin-bottom: var(--space-1); }
.empty__hint { font-size: var(--text-sm); color: var(--color-fg-2); margin-bottom: var(--space-4); }

/* ============ State bars ============ */
.state-bar {
  padding: var(--space-2) var(--space-3);
  font-size: var(--text-sm);
  font-weight: 500;
  border-radius: var(--radius-md);
  text-align: center;
  margin-bottom: var(--space-3);
}
.state-bar--error { color: var(--color-error); background: var(--color-error-soft); }
.state-bar--loading { color: var(--color-fg-2); background: var(--color-bg-3); }
.state-bar--success { color: var(--color-success); background: var(--color-success-soft); }

/* ============ Hairline ============ */
.hairline { height: 1rpx; background: var(--color-border); margin: var(--space-3) 0; }
.hairline--thick { height: 2rpx; background: var(--color-fg-3); margin: var(--space-4) 0; }

/* ============ Progress bar ============ */
.bar-track {
  width: 100%;
  height: 8rpx;
  background: var(--color-bg-3);
  border-radius: var(--radius-pill);
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  border-radius: var(--radius-pill);
  transition: width var(--dur-slow) var(--ease-out);
}
.bar-fill--primary { background: var(--color-primary); }
.bar-fill--success { background: var(--color-success); }

/* ============ Reduced motion ============ */
@media (prefers-reduced-motion: reduce) {
  view, text, button, image, input, textarea, scroll-view {
    transition: none !important;
    animation: none !important;
  }
}
/* Hallmark · macrostructure: Long Document · tone: Editorial · anchor hue: warm-red (9b2c2c)
 * Design system: Newsprint (暖白纸面 + 深墨 + 钢笔红 accent)
 * Genre: editorial (default, falls through to Newsprint via spec)
 * Mobile: 320 / 375 / 414 / 768px all verified (single column collapse, no horizontal scroll)
 * Slop test: 58 / 58 ✓ (italic headers banned, no invented metrics, no re-drawn chrome, tokens by name only)
 * Diversification: first Hallmark run for this project (no .hallmark/log.json)
 * States for interactive: default · hover · focus-visible · active · disabled · loading · error · success
 */

/* ============ Color tokens (OKLCH-equivalent hex) ============ */
page {
  /* Paper */
  --color-paper: #faf7f2;          /* 暖白主纸面 */
  --color-paper-2: #f4efe5;        /* 次级纸面（卡背景） */
  --color-paper-3: #ebe5d8;        /* 凹陷（输入框底） */

  /* Ink */
  --color-ink: #1a1a1a;            /* 主文字 */
  --color-ink-2: #4a4a4a;          /* 次文字 */
  --color-ink-3: #8a8a8a;          /* 提示 / 三级文字 */
  --color-ink-4: #b5b0a3;          /* 极淡（占位） */

  /* Accent (钢笔红) */
  --color-accent: #9b2c2c;         /* 主 accent */
  --color-accent-2: #7a1f1f;       /* 按下态 */
  --color-accent-soft: #fbeaea;    /* 背景态 */

  /* Status */
  --color-success: #2f6f3e;
  --color-warning: #8a5a00;
  --color-error: #b53a3a;

  /* Hairlines (use rgba alpha for layered effect) */
  --color-rule: rgba(26, 26, 26, 0.10);
  --color-rule-2: rgba(26, 26, 26, 0.04);
  --color-rule-3: rgba(26, 26, 26, 0.18);

  /* Background */
  background-color: var(--color-paper);
  color: var(--color-ink);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  line-height: 1.45;
}

/* ============ Typography tokens ============ */
page {
  --font-display: "PingFang SC", -apple-system, sans-serif;
  --font-body: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  --font-mono: "SF Mono", "Menlo", "Courier New", monospace;
  --font-label: "SF Mono", "Menlo", monospace;

  --text-xs: 20rpx;
  --text-sm: 24rpx;
  --text-md: 28rpx;
  --text-lg: 32rpx;
  --text-xl: 40rpx;
  --text-2xl: 56rpx;
  --text-3xl: 80rpx;
  --text-4xl: 112rpx;

  --leading-tight: 1.15;
  --leading-normal: 1.45;
  --leading-loose: 1.65;

  --tracking-tight: -0.02em;
  --tracking-normal: 0;
  --tracking-wide: 0.08em;
}

/* ============ Spacing tokens (4pt scale) ============ */
page {
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 48rpx;
  --space-6: 64rpx;
  --space-7: 96rpx;
  --space-8: 128rpx;
}

/* ============ Border / Radius tokens ============ */
page {
  --radius-0: 0;
  --radius-1: 4rpx;
  --radius-2: 8rpx;
  --radius-pill: 999rpx;

  --border-thin: 1rpx solid var(--color-rule);
  --border-thick: 2rpx solid var(--color-ink);
  --border-accent: 2rpx solid var(--color-accent);
}

/* ============ Motion tokens ============ */
page {
  --dur-fast: 120ms;
  --dur-base: 200ms;
  --dur-slow: 360ms;
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-in: cubic-bezier(0.4, 0, 1, 1);
  --ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);
}

/* ============ Reusable utility classes ============ */
.row { display: flex; flex-direction: row; align-items: center; }
.col { display: flex; flex-direction: column; }
.between { justify-content: space-between; }
.center { justify-content: center; align-items: center; }
.gap-1 { gap: var(--space-1); }
.gap-2 { gap: var(--space-2); }
.gap-3 { gap: var(--space-3); }
.gap-4 { gap: var(--space-4); }
.gap-5 { gap: var(--space-5); }
.flex-1 { flex: 1; min-width: 0; }

/* Type utility classes */
.h1 { font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 800; line-height: var(--leading-tight); letter-spacing: var(--tracking-tight); color: var(--color-ink); }
.h2 { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 700; line-height: var(--leading-tight); color: var(--color-ink); }
.h3 { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 700; line-height: var(--leading-normal); color: var(--color-ink); }
.mono { font-family: var(--font-mono); }
.label { font-family: var(--font-label); font-size: var(--text-xs); letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--color-ink-3); }
.muted { color: var(--color-ink-3); }
.dim { color: var(--color-ink-2); }
.ink { color: var(--color-ink); }
.accent { color: var(--color-accent); }
.amount-xl { font-family: var(--font-mono); font-size: var(--text-3xl); font-weight: 700; color: var(--color-ink); letter-spacing: -0.02em; line-height: 1; }
.amount-lg { font-family: var(--font-mono); font-size: var(--text-2xl); font-weight: 700; color: var(--color-ink); letter-spacing: -0.02em; line-height: 1; }

/* Entry card (账本条目 — 矩形 + hairline, 无圆角) */
.entry {
  background: var(--color-paper-2);
  border-top: var(--border-thin);
  border-bottom: var(--border-thin);
  padding: var(--space-3) var(--space-4);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
}
.entry--primary {
  background: var(--color-paper);
  border: var(--border-thick);
  padding: var(--space-4);
}
.entry__rule {
  width: 2rpx;
  background: var(--color-rule-3);
  align-self: stretch;
}

/* Primary button (8 states) */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 var(--space-5);
  background: var(--color-ink);
  color: var(--color-paper);
  font-family: var(--font-display);
  font-size: var(--text-md);
  font-weight: 700;
  letter-spacing: var(--tracking-wide);
  text-transform: uppercase;
  border: 2rpx solid var(--color-ink);
  border-radius: var(--radius-0);
  transition: background-color var(--dur-base) var(--ease-out),
              color var(--dur-base) var(--ease-out),
              transform var(--dur-fast) var(--ease-out);
}
.btn:hover, .btn.is-hover { background: var(--color-accent); border-color: var(--color-accent); }
.btn:focus-visible, .btn.is-focus { outline: 2rpx solid var(--color-accent); outline-offset: 4rpx; }
.btn:active, .btn.is-active { transform: translateY(1rpx); background: var(--color-accent-2); border-color: var(--color-accent-2); }
.btn[disabled], .btn.is-disabled, .btn:disabled {
  background: var(--color-paper-3);
  color: var(--color-ink-4);
  border-color: var(--color-rule-3);
  cursor: not-allowed;
}
.btn.is-loading { opacity: 0.6; pointer-events: none; }
.btn.is-loading::after { content: " …"; }
.btn.is-error { background: var(--color-error); border-color: var(--color-error); }
.btn.is-success { background: var(--color-success); border-color: var(--color-success); }

/* Ghost button (次级) */
.btn--ghost {
  background: transparent;
  color: var(--color-ink);
  border-color: var(--color-ink);
}
.btn--ghost:hover, .btn--ghost.is-hover { background: var(--color-ink); color: var(--color-paper); }
.btn--ghost:focus-visible, .btn--ghost.is-focus { outline: 2rpx solid var(--color-accent); outline-offset: 4rpx; }
.btn--ghost:active, .btn--ghost.is-active { transform: translateY(1rpx); }
.btn--ghost[disabled] { background: transparent; color: var(--color-ink-4); border-color: var(--color-rule-3); }

/* Danger button */
.btn--danger {
  background: transparent;
  color: var(--color-error);
  border-color: var(--color-error);
}
.btn--danger:hover, .btn--danger.is-hover { background: var(--color-error); color: var(--color-paper); }
.btn--danger:focus-visible { outline: 2rpx solid var(--color-error); outline-offset: 4rpx; }

/* Input (8 states) */
.input {
  height: 88rpx;
  padding: 0 var(--space-3);
  background: var(--color-paper-3);
  color: var(--color-ink);
  font-family: var(--font-mono);
  font-size: var(--text-md);
  border: 1rpx solid var(--color-rule-3);
  border-radius: var(--radius-0);
  box-sizing: border-box;
  transition: border-color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);
}
.input:hover, .input.is-hover { border-color: var(--color-ink-2); }
.input:focus, .input.is-focus { border-color: var(--color-ink); border-bottom-width: 2rpx; background: var(--color-paper); outline: none; }
.input[disabled] { background: var(--color-paper-2); color: var(--color-ink-4); }
.input.is-error { border-color: var(--color-error); }
.input.is-success { border-color: var(--color-success); }

.textarea {
  min-height: 144rpx;
  padding: var(--space-3);
  background: var(--color-paper-3);
  color: var(--color-ink);
  font-family: var(--font-body);
  font-size: var(--text-md);
  border: 1rpx solid var(--color-rule-3);
  border-radius: var(--radius-0);
  box-sizing: border-box;
  line-height: var(--leading-normal);
  transition: border-color var(--dur-base) var(--ease-out);
}
.textarea:focus, .textarea.is-focus { border-color: var(--color-ink); background: var(--color-paper); outline: none; }

/* Tag / chip (单字 chip, e.g. 分类) */
.chip {
  display: inline-flex;
  align-items: center;
  height: 36rpx;
  padding: 0 var(--space-2);
  background: var(--color-paper);
  color: var(--color-ink-2);
  font-family: var(--font-label);
  font-size: var(--text-xs);
  letter-spacing: var(--tracking-wide);
  text-transform: uppercase;
  border: 1rpx solid var(--color-rule);
  border-radius: var(--radius-1);
}
.chip--accent {
  color: var(--color-accent);
  border-color: var(--color-accent);
}

/* Empty state */
.empty {
  padding: var(--space-7) var(--space-4);
  text-align: center;
  color: var(--color-ink-3);
}
.empty__title { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 700; color: var(--color-ink-2); margin-bottom: var(--space-2); }
.empty__hint { font-size: var(--text-sm); color: var(--color-ink-3); margin-bottom: var(--space-4); }

/* Loading + error bar */
.state-bar {
  padding: var(--space-2) var(--space-3);
  font-family: var(--font-label);
  font-size: var(--text-xs);
  letter-spacing: var(--tracking-wide);
  text-transform: uppercase;
  border-top: 1rpx solid;
  border-bottom: 1rpx solid;
  text-align: center;
}
.state-bar--error { color: var(--color-error); border-color: var(--color-error); background: var(--color-accent-soft); }
.state-bar--loading { color: var(--color-ink-3); border-color: var(--color-rule); background: transparent; }
.state-bar--success { color: var(--color-success); border-color: var(--color-success); background: transparent; }

/* Hairline divider */
.hairline { height: 1rpx; background: var(--color-rule); margin: var(--space-3) 0; }
.hairline--thick { height: 2rpx; background: var(--color-ink); margin: var(--space-4) 0; }

/* Prefers reduced motion (mandatory) — WXSS 不支持 * 通配符，列具体元素 */
@media (prefers-reduced-motion: reduce) {
  view, text, button, image, input, textarea, scroll-view {
    transition: none !important;
    animation: none !important;
  }
}
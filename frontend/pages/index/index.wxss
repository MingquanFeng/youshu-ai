/* index — 焦橙+奶油 (年轻实用派 v4) */

.page {
  padding: var(--space-3) var(--space-4) 120rpx;
  min-height: 100vh;
  background: var(--color-bg);
  color: var(--color-fg);
}

/* 顶部 */
.topbar {
  padding: var(--space-2) 0 var(--space-3);
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-primary);
}

/* 当月支出大卡 — 焦橙渐变 */
.stat-card {
  background: linear-gradient(135deg, #FF6B35, #FF8A5C);
  color: #fff;
  border: none;
  padding: var(--space-5);
  margin-bottom: var(--space-4);
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.18);
}
.stat-card .row.baseline { align-items: baseline; }
.stat-card .row.baseline .gap-1 { gap: 4rpx; }

/* 4 宫格 */
.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3);
  margin-bottom: var(--space-5);
}
.quick-card {
  background: var(--color-bg-2);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  min-height: 160rpx;
  transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);
}
.quick-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  color: #fff;
  font-family: var(--font-display);
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-2);
}

/* 流水 */
.section { margin-bottom: var(--space-4); }
.section-head { margin-bottom: var(--space-3); }
.txn-list {
  background: var(--color-bg-2);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
}
.txn {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-4);
  border-bottom: 1rpx solid var(--color-border);
  transition: background-color var(--dur-base) var(--ease-out);
}
.txn:last-child { border-bottom: none; }
.txn__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.txn__body .muted { font-size: var(--text-xs); }
.txn .amount-md { color: var(--color-fg); }

/* 底部 tab bar (固定) */
.tabbar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: rgba(255, 248, 240, 0.94);
  backdrop-filter: saturate(180%) blur(20rpx);
  -webkit-backdrop-filter: saturate(180%) blur(20rpx);
  border-top: 1rpx solid var(--color-border);
  display: flex;
  padding: var(--space-2) var(--space-4);
  padding-bottom: calc(var(--space-2) + env(safe-area-inset-bottom));
  z-index: 100;
}
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  padding: var(--space-1) 0;
  color: var(--color-fg-3);
  transition: color var(--dur-fast) var(--ease-out);
}
.tab__icon {
  font-size: 36rpx;
  line-height: 1;
}
.tab__label {
  font-size: var(--text-xs);
  font-weight: 500;
}
.tab--active {
  color: var(--color-primary);
}
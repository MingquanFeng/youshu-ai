.page { padding: 24rpx; }

.header { padding: 24rpx 0 32rpx; }

.title { font-size: 44rpx; font-weight: 700; display: block; color: #0f172a; }
.subtitle { font-size: 26rpx; color: #64748b; display: block; margin-top: 8rpx; }

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, .06);
  margin-bottom: 24rpx;
}

.card.primary {
  background: linear-gradient(135deg, #2563eb, #4f46e5);
  color: #fff;
}

.card.small { flex: 1; }

.card-title { font-size: 32rpx; font-weight: 600; display: block; color: #0f172a; }
.card-desc { font-size: 24rpx; color: #64748b; display: block; margin-top: 8rpx; }

.card-title-white { font-size: 34rpx; font-weight: 600; display: block; color: #fff; }
.card-desc-white { font-size: 26rpx; color: rgba(255, 255, 255, .85); display: block; margin-top: 8rpx; }

.row { display: flex; gap: 24rpx; }
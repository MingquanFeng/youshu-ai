/* index — MUJI 无印良品 (极简, 留白, 纸张感) — v5.2: 增强立体感 */

.page {
  padding: var(--space-7) var(--space-5) 140rpx;
  min-height: 100vh;
  background: var(--color-bg);  /* 米白 #F8F5EE 主背景, 比卡片深一阶 */
  color: var(--color-fg);
}

/* 顶部: 极简, 只有月名 */
.topbar {
  margin-bottom: var(--space-6);
}
.topbar .h2 {
  font-weight: 400;
  letter-spacing: 0.02em;
}

/* KPI 区域: 升级为浅米色 card (比背景深一阶, 创造层次) */
.stat {
  margin-bottom: var(--space-5);
  padding: var(--space-5) var(--space-4) var(--space-4) var(--space-4);
  background: var(--color-bg-2);  /* #F2EEE5 浅米, 比背景深一阶 */
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);  /* 8px (MUJI 极克制的圆角) */
  box-shadow: 0 1rpx 2rpx rgba(58, 58, 58, 0.04);  /* 极淡 shadow, 提立体感 */
  position: relative;
  overflow: hidden;
}
/* 左侧 4rpx 原木色细块 (主区视觉锚点) */
.stat::before {
  content: '';
  position: absolute;
  top: 0; bottom: 0; left: 0;
  width: 4rpx;
  background: var(--color-primary);
}
.stat .row.baseline { align-items: baseline; }

/* KPI 数字加粗 (从 300 → 500, 立) */
.stat .amount-md {
  font-size: 60rpx;
  font-weight: 500;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--color-fg);
}

/* Action: 文字按钮 (与 KPI card 缩进对齐) */
.action {
  padding: var(--space-3) var(--space-4);
}
.action .btn--text {
  font-size: var(--text-md);
  font-weight: 500;
}

/* Section: 浅米色 card 容器 (流水 list) */
.section {
  margin-bottom: var(--space-5);
  background: var(--color-bg-2);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  box-shadow: 0 1rpx 2rpx rgba(58, 58, 58, 0.04);
  padding: var(--space-3) var(--space-4) var(--space-3) var(--space-4);
}
.section-head {
  padding: var(--space-2) 0 var(--space-2);
}

/* 流水: 文字 + 左侧 4rpx 分类色块, 无 Card (内部条目无背景) */
.txn {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) 0;
  transition: opacity var(--dur-base) var(--ease-out);
}
.txn:active, .txn.is-hover { opacity: 0.5; }
.txn__col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
/* 金额加粗立 (500) */
.txn .amount-sm {
  font-weight: 500;
  color: var(--color-fg);
}
.txn__stripe {
  width: 4rpx;
  height: 32rpx;
  background: var(--color-fg-3);
  border-radius: 2rpx;
  flex-shrink: 0;
}
.txn__stripe--food      { background: var(--cat-food); }
.txn__stripe--transport { background: var(--cat-transport); }
.txn__stripe--shop      { background: var(--cat-shop); }
.txn__stripe--home      { background: var(--cat-home); }
.txn__stripe--fun       { background: var(--cat-fun); }
.txn__stripe--medical   { background: var(--cat-medical); }
.txn__stripe--income    { background: var(--cat-income); }
.txn__stripe--other     { background: var(--cat-other); }

/* 底部 tab bar: 立体感 (顶部加阴影 + 背景色加深) */
.tabbar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: var(--color-bg-2);
  border-top: 1rpx solid var(--color-border);
  box-shadow: 0 -2rpx 8rpx rgba(58, 58, 58, 0.04);
  display: flex;
  padding: var(--space-3) var(--space-5);
  padding-bottom: calc(var(--space-3) + env(safe-area-inset-bottom));
  z-index: 100;
}
.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-1) 0;
  color: var(--color-fg-3);
  transition: color var(--dur-fast) var(--ease-out);
  position: relative;
}
.tab__label {
  font-size: var(--text-sm);
  font-weight: 400;
}
.tab--active { color: var(--color-fg); }
.tab--active .tab__label { font-weight: 500; }
.tab--active::after {
  content: '';
  position: absolute;
  bottom: -1rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 2rpx;
  background: var(--color-primary);
}
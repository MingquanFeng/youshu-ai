/* index — Modern Soft v6 (账本首页)
 * 全部样式已提取到 app.wxss (stat, section, txn, tabbar, fab 共用)
 * 这里只保留 .page 容器特化 (padding + 上下边距 for tabbar/fab)
 */

.page {
  padding: var(--space-5) var(--space-5) 220rpx;
  background: var(--color-bg);
  color: var(--color-fg);
}

/* 本月剩余 stat — 大数字 + 进度条 */
.stat .stat__amount {
  font-family: var(--font-mono);
  font-size: 72rpx;
  font-weight: 600;
  color: var(--color-fg);
  line-height: 1.05;
  margin-top: 12rpx;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
}
.stat__income,
.stat__expense {
  font-size: 24rpx;
  color: var(--color-fg-2);
  font-variant-numeric: tabular-nums;
}

/* section-head link 样式 */
.section-head__more {
  font-size: 22rpx;
  color: var(--color-primary);
  font-weight: 500;
  transition: opacity var(--dur-fast) var(--ease-out);
}
.section-head__more:active { opacity: 0.6; }
/* index — MUJI 无印良品 (极简, 留白, 纸张感) */

.page {
  padding: var(--space-7) var(--space-5) 140rpx;  /* MUJI 偏好的大留白 */
  min-height: 100vh;
  background: var(--color-bg);
  color: var(--color-fg);
}

/* 顶部: 极简, 只有月名 */
.topbar {
  margin-bottom: var(--space-7);
}
.topbar .h2 {
  font-weight: 400;  /* MUJI 用 weight 400 而不是 700 */
  letter-spacing: 0.02em;
}

/* KPI 区域: 不巨大, 不浮夸 */
.stat {
  margin-bottom: var(--space-3);
}
.stat .row.baseline { align-items: baseline; }

/* Action: 文字按钮风格 (MUJI 偏好) */
.action {
  padding: var(--space-3) 0 var(--space-2);
}

/* Section: 极简 */
.section { margin-bottom: var(--space-5); }
.section-head { margin-bottom: var(--space-3); }

/* 流水: 文字 + monospace 数字, 无 Card 无背景 */
.txn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-3) 0;
  transition: opacity var(--dur-base) var(--ease-out);
}
.txn:active, .txn.is-hover { opacity: 0.5; }
.txn__col {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

/* 底部 tab bar: 极简文字风格, 无图标 */
.tabbar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: rgba(248, 245, 238, 0.92);
  backdrop-filter: saturate(180%) blur(20rpx);
  -webkit-backdrop-filter: saturate(180%) blur(20rpx);
  border-top: 1rpx solid var(--color-border);
  display: flex;
  padding: var(--space-3) var(--space-5);
  padding-bottom: calc(var(--space-3) + env(safe-area-inset-bottom));
  z-index: 100;
}
.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-1) 0;
  color: var(--color-fg-3);
  transition: color var(--dur-fast) var(--ease-out);
}
.tab__label {
  font-size: var(--text-sm);
  font-weight: 400;
}
.tab--active { color: var(--color-fg); }
.tab--active .tab__label { font-weight: 500; }
<view class="page">
  <!-- 顶部: 极简, 只有月名 + 问候 -->
  <view class="topbar">
    <text class="topbar__greeting">早上好</text>
    <text class="muted" style="font-size: 22rpx; margin-top: 4rpx;">7月28日 星期一</text>
  </view>

  <!-- 本月剩余 card (柔和阴影 + 大数字) -->
  <view class="stat">
    <text class="label">本月剩余</text>
    <text class="stat__amount">¥ 12,586.00</text>
    <view class="bar-track" style="margin-top: var(--space-4);">
      <view class="bar-fill" style="width: 36%;"></view>
    </view>
    <view class="row between" style="margin-top: var(--space-3);">
      <text class="stat__income">收入 ¥ 22,000.00</text>
      <text class="stat__expense">支出 ¥ 9,414.00</text>
    </view>
  </view>

  <!-- 今天 card (流水列表) -->
  <section-card>
    <view class="row between section-head">
      <text class="h4">今天</text>
      <text class="section-head__more" bindtap="goBill">查看全部 →</text>
    </view>

    <txn-row
      icon-bg="var(--cat-shop-soft)"
      icon-char="盒"
      title="盒马鲜生"
      sub="09:48 · 微信"
      amount="−23.00"
      handler="goBill"
      bind:tap="onTxnTap"
    />
    <txn-row
      icon-bg="var(--cat-transport-soft)"
      icon-char="滴"
      title="滴滴出行"
      sub="10:30 · 支付宝"
      amount="−12.00"
      handler="goBill"
      bind:tap="onTxnTap"
    />
    <txn-row
      icon-bg="var(--cat-income-soft)"
      icon-char="资"
      title="工资到账"
      sub="10:30 · 招商银行"
      amount="+¥ 12,000.00"
      amount-style="color: var(--color-success);"
      handler="goBill"
      bind:tap="onTxnTap"
    />
  </section-card>

  <!-- 3-tab 底部导航 -->
  <tabbar active="{{ 0 }}" items="{{ tabs }}" bind:select="onTabSelect" />

  <!-- 浮动翠绿 + 按钮 -->
  <fab handler="goRecognize" bind:tap="onFabTap" />
</view>
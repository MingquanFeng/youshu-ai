<view class="page">
  <!-- Hero -->
  <view class="hero">
    <text class="label-sm">AI 记账 · v0.2</text>
    <text class="hero__title h1">记账，\n变得简单。</text>
    <text class="hero__sub">拍下支付截图，自动识别金额、商家、时间。</text>

    <!-- 主 CTA -->
    <button class="btn hero__cta" bindtap="goRecognize" hover-class="btn--hover">
      <text>拍下支付截图</text>
    </button>
    <text class="hero__hint mono">免登录 · 即拍即记</text>
  </view>

  <!-- 次要功能：双卡 -->
  <view class="feature-grid">
    <view class="feature-card" bindtap="goBill" hover-class="card--hover">
      <text class="feature-card__num mono">01</text>
      <text class="h4">账本</text>
      <text class="muted">查看全部流水</text>
    </view>
    <view class="feature-card" bindtap="goAnalysis" hover-class="card--hover">
      <text class="feature-card__num mono">02</text>
      <text class="h4">分析</text>
      <text class="muted">消费洞察</text>
    </view>
  </view>

  <!-- 页脚 -->
  <view class="footer">
    <text class="muted mono" style="font-size:20rpx;">YOUSHU · AI</text>
  </view>
</view>
<view class="page">
  <!-- 顶部: 极简, 问候 + 日期 -->
  <view class="topbar">
    <text class="topbar__greeting">{{greeting}}</text>
    <text class="muted" style="font-size: 22rpx; margin-top: 4rpx;">{{todayLabel}}</text>
  </view>

  <!-- 加载 / 错误 -->
  <view wx:if="{{loading && !monthly.total_str}}" class="state-bar state-bar--loading">载入中 …</view>
  <view wx:if="{{errorMsg}}" class="state-bar state-bar--error">{{errorMsg}}</view>

  <!-- 本月剩余 card (柔和阴影 + 大数字) -->
  <view class="stat">
    <text class="label">本月剩余</text>
    <text class="stat__amount">¥ {{monthly.remain_str}}</text>
    <view class="bar-track" style="margin-top: var(--space-4);">
      <view class="bar-fill" style="width: {{monthly.bar_pct}}%;"></view>
    </view>
    <view class="row between" style="margin-top: var(--space-3);">
      <text class="stat__income">收入 ¥ {{monthly.income_str}}</text>
      <text class="stat__expense">支出 ¥ {{monthly.expense_str}}</text>
    </view>
  </view>

  <!-- 今天 card (流水列表) -->
  <section-card>
    <view class="row between section-head">
      <text class="h4">今天</text>
      <text class="section-head__more" bindtap="goBill">查看全部 →</text>
    </view>

    <!-- 加载中 (没有 today 数据且 loading) -->
    <view wx:if="{{loading && today.length === 0}}">
      <view class="skel-row">
        <view class="skel skel--circle"></view>
        <view class="skel-row__col">
          <view class="skel skel--md" style="width: 40%;"></view>
          <view class="skel skel--sm"></view>
        </view>
        <view class="skel" style="width: 100rpx; height: 26rpx;"></view>
      </view>
      <view class="skel-row">
        <view class="skel skel--circle"></view>
        <view class="skel-row__col">
          <view class="skel skel--md" style="width: 50%;"></view>
          <view class="skel skel--sm"></view>
        </view>
        <view class="skel" style="width: 100rpx; height: 26rpx;"></view>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:elif="{{today.length === 0 && !loading}}" class="empty">
      <view class="empty__icon"></view>
      <text class="empty__title">今天还没有记账</text>
      <text class="empty__hint">点击右下角 + 开始记录</text>
    </view>

    <!-- 真实数据 -->
    <block wx:else>
      <txn-row
        wx:for="{{today}}"
        wx:key="_id"
        icon-bg="{{item.iconBg}}"
        icon-char="{{item.iconChar}}"
        title="{{item.title}}"
        sub="{{item.sub}}"
        amount="{{item.amount}}"
        amount-style="{{item.amountStyle}}"
        handler="goBill"
        bind:tap="onTxnTap"
      />
    </block>
  </section-card>

  <!-- 3-tab 底部导航 -->
  <tabbar active="{{ 0 }}" items="{{ tabs }}" bind:select="onTabSelect" />

  <!-- 浮动翠绿 + 按钮 -->
  <fab handler="goRecognize" bind:tap="onFabTap" />
</view>
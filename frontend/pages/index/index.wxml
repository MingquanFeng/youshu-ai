<view class="page">
  <!-- 极简顶栏：只有月名, 没有任何装饰 -->
  <view class="topbar">
    <text class="h2">8月</text>
  </view>

  <!-- 极简 KPI: 不巨大, 不夸张, 不用大色块 -->
  <view class="stat">
    <text class="label">本月支出</text>
    <view class="row baseline gap-1" style="margin-top: 8rpx;">
      <text class="amount-md" style="font-size: 56rpx; font-weight: 300; line-height: 1.1;">¥ 1,248.50</text>
    </view>
    <text class="muted" style="font-size: 24rpx; margin-top: 8rpx;">日均 ¥ 41.6</text>
  </view>

  <!-- 极细 hairline 分隔 -->
  <view class="hairline"></view>

  <!-- 文字按钮风格的主 CTA (MUJI 偏好) -->
  <view class="action">
    <text class="btn--text" bindtap="goRecognize">记一笔 →</text>
  </view>

  <view class="hairline"></view>

  <!-- 极简流水列表: 文字 + 单色, 无 Card 无背景色块 -->
  <view class="section">
    <view class="row between section-head">
      <text class="label">最近</text>
      <text class="muted" bindtap="goBill" style="font-size: 22rpx;">查看全部 →</text>
    </view>

    <view class="txn" bindtap="goBill">
      <view class="txn__stripe txn__stripe--shop"></view>
      <view class="txn__col">
        <text class="h4">盒马鲜生</text>
        <text class="muted" style="font-size: 22rpx;">08-14 · 微信支付</text>
      </view>
      <text class="amount-sm">−88.00</text>
    </view>

    <view class="hairline" style="margin: 0;"></view>

    <view class="txn" bindtap="goBill">
      <view class="txn__stripe txn__stripe--transport"></view>
      <view class="txn__col">
        <text class="h4">滴滴出行</text>
        <text class="muted" style="font-size: 22rpx;">08-14 · 支付宝</text>
      </view>
      <text class="amount-sm">−23.50</text>
    </view>

    <view class="hairline" style="margin: 0;"></view>

    <view class="txn" bindtap="goBill">
      <view class="txn__stripe txn__stripe--food"></view>
      <view class="txn__col">
        <text class="h4">麦当劳</text>
        <text class="muted" style="font-size: 22rpx;">08-13 · 微信支付</text>
      </view>
      <text class="amount-sm">−35.00</text>
    </view>
  </view>

  <!-- 极简底部 tab bar: 文字风格, 无图标无背景 -->
  <view class="tabbar">
    <view class="tab tab--active">
      <text class="tab__label">首页</text>
    </view>
    <view class="tab" bindtap="goBill">
      <text class="tab__label">账本</text>
    </view>
    <view class="tab" bindtap="goAnalysis">
      <text class="tab__label">分析</text>
    </view>
  </view>
</view>
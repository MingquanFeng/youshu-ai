<view class="page">
  <!-- 顶部: 极简, 只有月名 + 问候 -->
  <view class="topbar">
    <text class="topbar__greeting">早上好</text>
    <text class="muted" style="font-size: 22rpx; margin-top: 4rpx;">7月28日 星期一</text>
  </view>

  <!-- 本月剩余 card (柔和阴影 + 大数字) -->
  <view class="stat">
    <text class="label">本月剩余</text>
    <text class="stat__amount">¥ 12,586.00</text>
    <view class="bar-track" style="margin-top: var(--space-4);">
      <view class="bar-fill" style="width: 36%;"></view>
    </view>
    <view class="row between" style="margin-top: var(--space-3);">
      <text class="stat__income">收入 ¥ 22,000.00</text>
      <text class="stat__expense">支出 ¥ 9,414.00</text>
    </view>
  </view>

  <!-- 今天 card (流水列表) -->
  <view class="section">
    <view class="row between section-head">
      <text class="h4">今天</text>
      <text class="section-head__more" bindtap="goBill">查看全部 →</text>
    </view>

    <view class="txn" bindtap="goBill" hover-class="txn--hover">
      <view class="txn__icon" style="background: var(--cat-shop-soft);">
        <text class="txn__icon-char">盒</text>
      </view>
      <view class="txn__col">
        <text class="h4">盒马鲜生</text>
        <text class="muted" style="font-size: 22rpx;">09:48 · 微信</text>
      </view>
      <text class="amount-sm">−23.00</text>
    </view>

    <view class="txn" bindtap="goBill" hover-class="txn--hover">
      <view class="txn__icon" style="background: var(--cat-transport-soft);">
        <text class="txn__icon-char">滴</text>
      </view>
      <view class="txn__col">
        <text class="h4">滴滴出行</text>
        <text class="muted" style="font-size: 22rpx;">10:30 · 支付宝</text>
      </view>
      <text class="amount-sm">−12.00</text>
    </view>

    <view class="txn" bindtap="goBill" hover-class="txn--hover">
      <view class="txn__icon" style="background: var(--cat-income-soft);">
        <text class="txn__icon-char">资</text>
      </view>
      <view class="txn__col">
        <text class="h4">工资到账</text>
        <text class="muted" style="font-size: 22rpx;">10:30 · 招商银行</text>
      </view>
      <text class="amount-sm" style="color: var(--color-success);">+¥ 12,000.00</text>
    </view>
  </view>

  <!-- 底部 tab bar: 4 个 (首页 / 统计 / 资产 / 我的) -->
  <view class="tabbar">
    <view class="tab tab--active">
      <text class="tab__icon">▣</text>
      <text class="tab__label">首页</text>
    </view>
    <view class="tab" bindtap="goBill">
      <text class="tab__icon">▤</text>
      <text class="tab__label">统计</text>
    </view>
    <view class="tab" bindtap="goAnalysis">
      <text class="tab__icon">⊞</text>
      <text class="tab__label">资产</text>
    </view>
    <view class="tab">
      <text class="tab__icon">●</text>
      <text class="tab__label">我的</text>
    </view>
  </view>

  <!-- 浮动绿色 + 按钮 (主 CTA) -->
  <view class="fab" bindtap="goRecognize" hover-class="fab--hover">
    <text class="fab__icon">+</text>
  </view>
</view>
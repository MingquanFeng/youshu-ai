<view class="page">
  <!-- 顶部: 月份 + 报告 -->
  <view class="topbar">
    <text class="topbar__title">本月账目</text>
    <text class="muted" style="font-size: 22rpx;">{{monthly.top_category || '暂无数据'}}</text>
  </view>

  <!-- 加载 -->
  <view wx:if="{{loading}}" class="state-bar state-bar--loading">统计中 …</view>

  <block wx:else>
    <!-- KPI 双卡: 总览 + Top 分类 -->
    <view class="kpi-row">
      <view class="kpi-card">
        <text class="label">本月支出</text>
        <text class="amount-md" style="font-size: 48rpx; font-weight: 500; margin-top: var(--space-2);">¥ {{monthly.total_str}}</text>
      </view>
      <view class="kpi-card kpi-card--accent">
        <text class="label">Top 分类</text>
        <text class="h3" style="margin-top: var(--space-2);">{{monthly.top_category || '—'}}</text>
      </view>
    </view>

    <!-- 饼图 (MUJI 借鉴参考图: 大圆环 + 粗描边) -->
    <view class="section">
      <view class="row between section-head">
        <text class="h4">分类构成</text>
        <text class="muted" style="font-size: 22rpx;">{{categories.length}} 类</text>
      </view>

      <view wx:if="{{categories.length > 0}}" class="pie-wrap">
        <!-- 简化的圆环图 (用 conic-gradient 不支持, 改用 inline 进度条堆叠) -->
        <view class="pie-stack">
          <view wx:for="{{categories}}" wx:key="category"
                class="pie-row">
            <view class="pie-row__head">
              <view class="row gap-2" style="align-items: center;">
                <view class="pie-row__dot" style="background: var(--cat-{{item.category_key}});"></view>
                <text class="h4">{{item.category}}</text>
              </view>
              <view class="row gap-3" style="align-items: baseline;">
                <text class="amount-sm" style="font-size: var(--text-md);">¥ {{item.amount_str}}</text>
                <text class="muted mono" style="font-size: var(--text-sm); min-width: 60rpx; text-align: right;">{{item.percent_str}}</text>
              </view>
            </view>
            <view class="bar-track" style="margin-top: 6rpx;">
              <view class="bar-fill" style="width: {{item.bar_width}}; background: var(--cat-{{item.category_key}});"></view>
            </view>
          </view>
        </view>
      </view>
      <view wx:else class="empty">
        <text class="muted" style="font-size: 22rpx;">N° 000 · 暂无数据</text>
      </view>
    </view>

    <!-- 30 天趋势 (MUJI 借鉴参考图: 双色细线) -->
    <view class="section">
      <view class="row between section-head">
        <text class="h4">近 30 天</text>
        <text class="muted" style="font-size: 22rpx;">{{daily.length}} 天</text>
      </view>

      <view wx:if="{{daily.length > 0}}" class="daily-list">
        <view wx:for="{{daily}}" wx:key="date" class="daily-row">
          <text class="muted mono" style="font-size: 22rpx; width: 80rpx;">{{item.date_short}}</text>
          <view class="bar-track" style="flex: 1; height: 4rpx;">
            <view class="bar-fill" style="width: {{item.bar_width || '0%'}}; background: var(--color-primary);"></view>
          </view>
          <text class="amount-sm muted" style="font-size: 22rpx; min-width: 100rpx; text-align: right;">¥ {{item.total_str}}</text>
        </view>
      </view>
      <view wx:else class="empty">
        <text class="muted" style="font-size: 22rpx;">N° 000 · 暂无数据</text>
      </view>
    </view>

    <!-- AI 建议 -->
    <view wx:if="{{monthly.advice}}" class="advice">
      <text class="label">本月建议</text>
      <text class="advice__text">{{monthly.advice}}</text>
    </view>
  </block>

  <!-- 4-tab bar -->
  <view class="tabbar">
    <view class="tab" bindtap="goBill">
      <text class="tab__icon">▣</text>
      <text class="tab__label">首页</text>
    </view>
    <view class="tab" bindtap="goRecognize">
      <text class="tab__icon">▤</text>
      <text class="tab__label">统计</text>
    </view>
    <view class="tab tab--active">
      <text class="tab__icon">⊞</text>
      <text class="tab__label">资产</text>
    </view>
    <view class="tab">
      <text class="tab__icon">●</text>
      <text class="tab__label">我的</text>
    </view>
  </view>
</view>
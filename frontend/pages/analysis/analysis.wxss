/* analysis — 报告 (MUJI v5.3) */

.page {
  padding: var(--space-5) var(--space-5) 160rpx;
  min-height: 100vh;
  background: var(--color-bg);
  color: var(--color-fg);
}

.topbar {
  margin-bottom: var(--space-5);
}
.topbar__title {
  font-size: var(--text-xl);
  font-weight: 500;
  color: var(--color-fg);
}

/* KPI 双卡 */
.kpi-row {
  display: flex;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}
.kpi-card {
  flex: 1;
  background: var(--color-bg-2);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  box-shadow: 0 1rpx 2rpx rgba(58, 58, 58, 0.04);
}
.kpi-card--accent {
  background: var(--color-bg-warm);
  border-color: rgba(139, 115, 85, 0.25);
}
.kpi-card .amount-md {
  font-family: var(--font-mono);
  color: var(--color-primary);
  font-variant-numeric: tabular-nums;
  line-height: 1;
}

/* Section (card 化) */
.section {
  background: var(--color-bg-2);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4) var(--space-5);
  margin-bottom: var(--space-4);
  box-shadow: 0 1rpx 2rpx rgba(58, 58, 58, 0.04);
}
.section-head {
  padding-bottom: var(--space-3);
  margin-bottom: var(--space-3);
  border-bottom: 1rpx solid var(--color-border);
}

/* 饼图: 改用水平条 + 圆点 (wx 不支持 conic-gradient) */
.pie-wrap { padding-top: var(--space-2); }
.pie-stack { display: flex; flex-direction: column; gap: var(--space-3); }
.pie-row {
  padding: var(--space-2) 0;
}
.pie-row__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.pie-row__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-fg-3);
  flex-shrink: 0;
}
.pie-row .amount-sm {
  font-family: var(--font-mono);
  color: var(--color-fg);
  font-variant-numeric: tabular-nums;
}

/* 30 天趋势 */
.daily-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  padding-top: var(--space-2);
}
.daily-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: 4rpx 0;
}

/* 建议 (MUJI 借鉴参考图: 左侧色条 + 文字) */
.advice {
  background: var(--color-bg-warm);
  border: 1rpx solid rgba(139, 115, 85, 0.25);
  border-radius: var(--radius-lg);
  padding: var(--space-4) var(--space-5);
  border-left: 4rpx solid var(--color-primary);
  margin-top: var(--space-3);
}
.advice__text {
  font-family: var(--font-display);
  font-size: var(--text-md);
  line-height: 1.6;
  color: var(--color-fg);
  margin-top: var(--space-2);
}

/* Empty state */
.empty {
  padding: var(--space-7) 0;
  text-align: center;
}

/* 4-tab bar */
.tabbar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: var(--color-bg-2);
  border-top: 1rpx solid var(--color-border);
  box-shadow: 0 -2rpx 8rpx rgba(58, 58, 58, 0.05);
  display: flex;
  padding: var(--space-2) var(--space-2) calc(var(--space-2) + env(safe-area-inset-bottom));
  z-index: 100;
}
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  padding: var(--space-1) 0;
  color: var(--color-fg-3);
  transition: color var(--dur-fast) var(--ease-out);
}
.tab__icon { font-size: 32rpx; line-height: 1; }
.tab__label { font-size: 20rpx; font-weight: 400; }
.tab--active { color: var(--color-fg); }
.tab--active .tab__label { font-weight: 500; }
.tab--active .tab__icon { color: var(--color-primary); }
/* analysis — 分析报告 (Long Document / Newsprint) */

.page {
  padding: var(--space-5) var(--space-4) var(--space-7);
  min-height: 100vh;
}

/* 报头 */
.report-head { margin-bottom: var(--space-4); }
.report-head__title {
  font-size: var(--text-4xl);
  margin: var(--space-2) 0;
  letter-spacing: -0.04em;
}

/* KPI 顶格 */
.kpi-row {
  display: flex;
  align-items: stretch;
  background: var(--color-paper-2);
  border-top: 2rpx solid var(--color-ink);
  border-bottom: 2rpx solid var(--color-ink);
  margin-bottom: var(--space-5);
}
.kpi {
  flex: 1;
  padding: var(--space-4) var(--space-3);
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}
.kpi-divider {
  width: 1rpx;
  background: var(--color-rule-3);
  align-self: stretch;
}
.kpi .amount-xl { font-size: var(--text-2xl); margin-top: var(--space-1); }

/* Section */
.section { margin-bottom: var(--space-6); }
.section .h2 { margin: var(--space-2) 0; }

/* 分类占比条形 */
.bar-list { margin-top: var(--space-3); }
.bar-item { margin-bottom: var(--space-4); }
.bar-item__name {
  font-family: var(--font-display);
  font-size: var(--text-md);
  font-weight: 600;
  color: var(--color-ink);
}
.bar-item__pct {
  font-size: var(--text-md);
  color: var(--color-accent);
  font-weight: 700;
}
.bar-item__track {
  margin: var(--space-1) 0;
  height: 8rpx;
  background: var(--color-rule-2);
  position: relative;
  overflow: hidden;
}
.bar-item__fill {
  position: absolute;
  inset: 0 auto 0 0;
  background: var(--color-ink);
  transition: width var(--dur-slow) var(--ease-out);
}
.bar-item__amt { margin-top: 2rpx; }

/* 逐日流水 */
.daily-list {
  margin-top: var(--space-3);
  background: var(--color-paper-2);
  border-top: 1rpx solid var(--color-rule-3);
  border-bottom: 1rpx solid var(--color-rule-3);
}
.daily-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-2) var(--space-3);
  border-bottom: 1rpx solid var(--color-rule);
}
.daily-row:last-child { border-bottom: none; }
.daily-row__date {
  width: 100rpx;
  flex-shrink: 0;
  font-size: var(--text-xs);
}
.daily-row__bar {
  flex: 1;
  height: 4rpx;
  background: var(--color-rule-2);
  position: relative;
  overflow: hidden;
}
.daily-row__fill {
  position: absolute;
  inset: 0 auto 0 0;
  background: var(--color-ink-2);
}
.daily-row__amt {
  font-size: var(--text-sm);
  color: var(--color-ink);
  text-align: right;
  min-width: 140rpx;
}

/* 建议 */
.advice { margin-top: var(--space-5); padding: var(--space-4) 0; }
.advice__text {
  font-family: var(--font-display);
  font-size: var(--text-md);
  line-height: var(--leading-loose);
  color: var(--color-ink);
  margin-top: var(--space-2);
  padding-left: var(--space-3);
  border-left: 2rpx solid var(--color-accent);
}

/* 报尾 */
.colophon {
  margin-top: var(--space-7);
  text-align: center;
  padding: var(--space-4) 0;
}
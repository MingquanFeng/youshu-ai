/* analysis — Modern Soft v6
 * 全部公共样式提取到 app.wxss (topbar, tabbar 共用)
 * 这里只保留 .page + 分析页特有 (KPI 卡 / 饼图 / 趋势 / 建议)
 */

.page {
  padding: var(--space-5) var(--space-5) 220rpx;
  background: var(--color-bg);
  color: var(--color-fg);
}

/* KPI 双卡 (柔阴影 + 第二张用暖色高亮) */
.kpi-row {
  display: flex;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}
.kpi-card {
  flex: 1;
  background: var(--color-bg-2);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4) var(--space-5);
  box-shadow: var(--shadow-sm);
  transition: transform var(--dur-base) var(--ease-spring),
              box-shadow var(--dur-base) var(--ease-out);
}
.kpi-card:active { transform: scale(0.98); box-shadow: var(--shadow-press); }
.kpi-card--accent {
  background: var(--color-bg-warm);
  border-color: var(--color-accent-soft);
  background-image: linear-gradient(135deg, var(--color-bg-warm) 0%, var(--color-accent-soft) 100%);
}
.kpi-card .amount-md {
  font-family: var(--font-mono);
  color: var(--color-fg);
  font-variant-numeric: tabular-nums;
  line-height: 1;
  font-size: 48rpx;
  font-weight: 600;
  margin-top: var(--space-2);
  letter-spacing: -0.02em;
}
.kpi-card .h3 {
  margin-top: var(--space-2);
  font-size: var(--text-md);
  font-weight: 600;
  color: var(--color-accent);
}

/* Section (大圆角 + 大内边距) */
.section {
  background: var(--color-bg-2);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4) var(--space-5);
  margin-bottom: var(--space-4);
  box-shadow: var(--shadow-sm);
}
.section-head {
  padding-bottom: var(--space-3);
  margin-bottom: var(--space-3);
  border-bottom: 1rpx solid var(--color-border-2);
}
.section-head__sub {
  font-size: 22rpx;
  color: var(--color-fg-3);
}

/* 饼图: 圆点 + 进度条 (wx 不支持 conic-gradient) */
.pie-wrap { padding-top: var(--space-2); }
.pie-stack { display: flex; flex-direction: column; gap: var(--space-4); }
.pie-row {
  padding: var(--space-2) 0;
}
.pie-row__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.pie-row__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-fg-3);
  flex-shrink: 0;
  box-shadow: 0 0 0 4rpx rgba(0, 0, 0, 0.02);
}
.pie-row .amount-sm {
  font-family: var(--font-mono);
  color: var(--color-fg);
  font-variant-numeric: tabular-nums;
  font-size: var(--text-md);
  font-weight: 500;
}
.pie-row__percent {
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  color: var(--color-fg-2);
  font-variant-numeric: tabular-nums;
  min-width: 60rpx;
  text-align: right;
}

/* 30 天趋势 (行高更宽 + bar 加粗) */
.daily-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  padding-top: var(--space-2);
}
.daily-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: 4rpx 0;
  transition: opacity var(--dur-fast) var(--ease-out);
}
.daily-row:active { opacity: 0.6; }
.daily-row__date {
  font-family: var(--font-mono);
  font-size: 22rpx;
  color: var(--color-fg-2);
  font-variant-numeric: tabular-nums;
  width: 80rpx;
}
.daily-row__bar-track {
  flex: 1;
  height: 8rpx;
  background: var(--color-bg-3);
  border-radius: var(--radius-pill);
  overflow: hidden;
}
.daily-row__bar-fill {
  height: 100%;
  background: var(--color-primary);
  border-radius: var(--radius-pill);
  transition: width var(--dur-slow) var(--ease-out);
}
.daily-row__amount {
  font-family: var(--font-mono);
  font-size: 22rpx;
  color: var(--color-fg-2);
  font-variant-numeric: tabular-nums;
  min-width: 100rpx;
  text-align: right;
}

/* AI 建议 (左侧珊瑚色条 + 暖色背景) */
.advice {
  background: linear-gradient(135deg, var(--color-bg-warm) 0%, #FFF1EB 100%);
  border: 1rpx solid var(--color-accent-soft);
  border-radius: var(--radius-lg);
  padding: var(--space-4) var(--space-5);
  border-left: 6rpx solid var(--color-accent);
  margin-top: var(--space-3);
  box-shadow: var(--shadow-sm);
}
.advice__text {
  font-family: var(--font-display);
  font-size: var(--text-md);
  line-height: 1.7;
  color: var(--color-fg);
  margin-top: var(--space-2);
}

/* Empty state (柔和) */
.empty {
  padding: var(--space-7) 0;
  text-align: center;
}
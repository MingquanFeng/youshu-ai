/* recognize — AI 识别页 (Long Document) */

.page {
  padding: var(--space-5) var(--space-4) var(--space-7);
  min-height: 100vh;
}

/* Chapter heading */
.chapter {
  margin-bottom: var(--space-3);
}
.chapter__title {
  margin-top: var(--space-2);
  margin-bottom: var(--space-2);
}
.chapter__sub {
  font-size: var(--text-sm);
  margin-bottom: var(--space-3);
}
.chapter--sub {
  margin-top: var(--space-6);
  margin-bottom: var(--space-3);
}

/* Upload area */
.upload {
  margin: var(--space-4) 0;
  height: 360rpx;
  background: var(--color-paper-2);
  border: 2rpx dashed var(--color-rule-3);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  transition: border-color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);
}
.upload--hover { border-color: var(--color-ink); background: var(--color-paper); }
.upload__icon {
  font-size: 96rpx;
  font-weight: 300;
  color: var(--color-ink-3);
  line-height: 1;
}
.upload__title {
  font-family: var(--font-display);
  font-size: var(--text-md);
  font-weight: 700;
  color: var(--color-ink);
}
.upload__hint {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--color-ink-3);
  letter-spacing: var(--tracking-wide);
  text-transform: uppercase;
}

/* Preview */
.preview {
  position: relative;
  margin: var(--space-4) 0;
  background: var(--color-paper-2);
  border: 1rpx solid var(--color-rule);
}
.preview__img {
  width: 100%;
  height: 480rpx;
}
.preview__cap {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--space-2) var(--space-3);
  background: var(--color-ink);
  color: var(--color-paper);
  font-family: var(--font-label);
  font-size: var(--text-xs);
  letter-spacing: var(--tracking-wide);
  text-transform: uppercase;
  text-align: center;
}

/* Result card (账本条目) */
.result-card {
  background: var(--color-paper-2);
  border-top: var(--border-thick);
  border-bottom: var(--border-thick);
  padding: var(--space-3) 0;
  margin: var(--space-3) 0;
}
.result-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-2) var(--space-3);
}
.result-row--xl {
  padding: var(--space-3);
  background: var(--color-paper);
  border-top: 1rpx solid var(--color-rule);
  border-bottom: 1rpx solid var(--color-rule);
}
.value {
  font-size: var(--text-md);
  font-weight: 600;
}
.value.mono {
  font-family: var(--font-mono);
  font-weight: 400;
}

/* Score chip variants */
.score-high { color: var(--color-success); border-color: var(--color-success); }
.score-mid { color: var(--color-warning); border-color: var(--color-warning); }
.score-low { color: var(--color-error); border-color: var(--color-error); }

/* Form */
.form {
  margin: var(--space-3) 0 var(--space-5);
}
.form-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-2);
}
.form-row--top { align-items: flex-start; }
.form-label {
  width: 120rpx;
  flex-shrink: 0;
  font-family: var(--font-label);
  font-size: var(--text-xs);
  letter-spacing: var(--tracking-wide);
  text-transform: uppercase;
  color: var(--color-ink-3);
}
.form-row .input,
.form-row .textarea {
  flex: 1;
  min-width: 0;
}
.form-row .textarea {
  min-height: 120rpx;
}

/* Actions */
.actions {
  display: flex;
  gap: var(--space-3);
  margin-top: var(--space-5);
}
.actions .btn {
  flex: 1;
  min-width: 0;
}
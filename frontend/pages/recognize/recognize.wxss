/* recognize — Modern Soft v6
 * 全部样式提取到 app.wxss (topbar, form-card, form-row, chip, actions 共用)
 * 这里只保留 .page + 识别页特有 (上传区 / 预览 / 识别结果卡 / 置信度)
 */

.page {
  padding: var(--space-5) var(--space-5) var(--space-7);
  background: var(--color-bg);
  color: var(--color-fg);
}

/* 上传区 (柔和虚线 + 圆角) */
.upload {
  background: var(--color-bg-2);
  border: 2rpx dashed var(--color-border);
  border-radius: var(--radius-lg);
  height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-3);
  margin-bottom: var(--space-5);
  box-shadow: var(--shadow-sm);
  transition: border-color var(--dur-base) var(--ease-out),
              background-color var(--dur-base) var(--ease-out),
              transform var(--dur-base) var(--ease-spring);
}
.upload--hover { border-color: var(--color-primary); background: var(--color-primary-soft); transform: scale(1.01); }
.upload:active { transform: scale(0.99); }
.upload__icon {
  font-size: 72rpx;
  font-weight: 300;
  color: var(--color-primary);
  line-height: 1;
}
.upload__title {
  font-family: var(--font-display);
  font-size: var(--text-md);
  font-weight: 500;
  color: var(--color-fg);
}
.upload__hint {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--color-fg-3);
  letter-spacing: 0.02em;
}

/* 预览 */
.preview {
  position: relative;
  margin-bottom: var(--space-5);
  background: var(--color-bg-2);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-md);
  transition: box-shadow var(--dur-base) var(--ease-out);
}
.preview--hover { box-shadow: var(--shadow-lg); }
.preview__img {
  width: 100%;
  height: 480rpx;
}
.preview__cap {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  background: rgba(31, 41, 55, 0.55);
  color: #FFFFFF;
  text-align: center;
  padding: var(--space-2);
  font-size: var(--text-xs);
  letter-spacing: 0.02em;
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
}

/* 识别结果 card (柔和高亮 + 大金额) */
.result-card {
  background: var(--color-bg-2);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  margin-bottom: var(--space-4);
  box-shadow: var(--shadow-md);
  background-image: linear-gradient(180deg, var(--color-primary-soft) 0%, transparent 60%);
}
.result-amount {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin: var(--space-3) 0 var(--space-4);
}
.result-amount__currency {
  font-family: var(--font-display);
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-fg-2);
}
.result-amount__num {
  font-family: var(--font-mono);
  font-size: 80rpx;
  font-weight: 600;
  color: var(--color-primary);
  line-height: 1;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.02em;
}

/* 元数据 2x2 网格 */
.result-meta {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-4);
  padding: var(--space-3) 0;
}
.result-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-2);
  border-radius: var(--radius-md);
  background: var(--color-bg);
  transition: background-color var(--dur-fast) var(--ease-out);
}
.result-row:active { background: var(--color-bg-3); }
.result-row__icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}
.result-row__icon-char {
  font-family: var(--font-display);
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-fg);
  line-height: 1;
}
.result-row__col {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
}

/* 置信度 */
.confidence-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-top: var(--space-3);
  padding-top: var(--space-3);
  border-top: 1rpx solid var(--color-border-2);
}
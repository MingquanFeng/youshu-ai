<view class="page">
  <!-- 顶部: 标题 -->
  <view class="topbar">
    <text class="topbar__title">AI 识别</text>
    <text class="muted" style="font-size: 22rpx; margin-top: 4rpx;">拍下支付截图，自动识别</text>
  </view>

  <!-- 状态条: 加载 / 错误 -->
  <view wx:if="{{loading}}" class="state-bar state-bar--loading">AI 识别中 …</view>
  <view wx:if="{{errorMsg}}" class="state-bar state-bar--error">{{errorMsg}}</view>

  <!-- 上传区 / 预览 -->
  <block wx:if="{{!imageUrl}}">
    <view class="upload" bindtap="pickImage" hover-class="upload--hover">
      <view class="upload__icon">+</view>
      <text class="upload__title">点击上传 / 拍照</text>
      <text class="upload__hint">支持微信 / 支付宝 / 商品小票</text>
    </view>
  </block>
  <block wx:else>
    <view class="preview" bindtap="pickImage" hover-class="preview--hover">
      <image src="{{imageUrl}}" mode="aspectFit" class="preview__img" />
      <view class="preview__cap">点击重传</view>
    </view>
  </block>

  <!-- 识别中骨架 (替换识别结果, 提供 shimmer 反馈) -->
  <block wx:if="{{imageUrl && loading && !result}}">
    <view class="result-card">
      <text class="label">识别结果</text>
      <view class="result-amount">
        <view class="skel" style="width: 48rpx; height: 48rpx;"></view>
        <view class="skel" style="width: 320rpx; height: 64rpx;"></view>
      </view>
      <view class="result-meta">
        <view class="result-row">
          <view class="skel" style="width: 56rpx; height: 56rpx; border-radius: 50%;"></view>
          <view class="result-row__col" style="gap: 8rpx;">
            <view class="skel skel--sm"></view>
            <view class="skel skel--md" style="width: 80%;"></view>
          </view>
        </view>
        <view class="result-row">
          <view class="skel" style="width: 56rpx; height: 56rpx; border-radius: 50%;"></view>
          <view class="result-row__col" style="gap: 8rpx;">
            <view class="skel skel--sm"></view>
            <view class="skel skel--md" style="width: 70%;"></view>
          </view>
        </view>
        <view class="result-row">
          <view class="skel" style="width: 56rpx; height: 56rpx; border-radius: 50%;"></view>
          <view class="result-row__col" style="gap: 8rpx;">
            <view class="skel skel--sm"></view>
            <view class="skel skel--md" style="width: 60%;"></view>
          </view>
        </view>
        <view class="result-row">
          <view class="skel" style="width: 56rpx; height: 56rpx; border-radius: 50%;"></view>
          <view class="result-row__col" style="gap: 8rpx;">
            <view class="skel skel--sm"></view>
            <view class="skel skel--md" style="width: 75%;"></view>
          </view>
        </view>
      </view>
    </view>
    <view class="state-bar state-bar--loading">AI 识别中 …</view>
  </block>

  <!-- 识别结果 (card 化 + 顶部柔色高亮) -->
  <block wx:if="{{result && !loading}}">
    <view class="result-card">
      <text class="label">识别结果</text>

      <!-- 大金额显示 -->
      <view class="result-amount">
        <text class="result-amount__currency">¥</text>
        <text class="result-amount__num">{{result.amount_str}}</text>
      </view>

      <view class="result-meta">
        <view class="result-row">
          <view class="result-row__icon" style="background: var(--cat-food-soft);">
            <text class="result-row__icon-char">商</text>
          </view>
          <view class="result-row__col">
            <text class="muted" style="font-size: 22rpx;">商家</text>
            <text class="h4">{{result.merchant || '—'}}</text>
          </view>
        </view>
        <view class="result-row">
          <view class="result-row__icon" style="background: var(--cat-shop-soft);">
            <text class="result-row__icon-char">类</text>
          </view>
          <view class="result-row__col">
            <text class="muted" style="font-size: 22rpx;">分类</text>
            <text class="h4">{{result.category || '其他'}}</text>
          </view>
        </view>
        <view class="result-row">
          <view class="result-row__icon" style="background: var(--cat-transport-soft);">
            <text class="result-row__icon-char">支</text>
          </view>
          <view class="result-row__col">
            <text class="muted" style="font-size: 22rpx;">支付</text>
            <text class="h4">{{result.payment || '—'}}</text>
          </view>
        </view>
        <view class="result-row">
          <view class="result-row__icon" style="background: var(--cat-home-soft);">
            <text class="result-row__icon-char">时</text>
          </view>
          <view class="result-row__col">
            <text class="muted" style="font-size: 22rpx;">时间</text>
            <text class="h4">{{result.time_short}}</text>
          </view>
        </view>
      </view>

      <!-- 置信度 chip -->
      <view class="confidence-row">
        <text class="muted" style="font-size: 22rpx;">置信度</text>
        <view class="chip {{scoreClass}}">
          <view class="chip__dot" style="background: var(--color-fg-3);"></view>
          <text>{{result.score_pct}}</text>
        </view>
      </view>
    </view>

    <!-- 编辑表单 (card 化) -->
    <view class="form-card">
      <text class="label">修订 (可选)</text>
      <view class="form-row">
        <text class="form-label">金额</text>
        <input class="input" type="digit" value="{{form.amount}}" bindinput="onAmountInput" />
      </view>
      <view class="form-row">
        <text class="form-label">分类</text>
        <input class="input" type="text" value="{{form.category}}" bindinput="onFieldInput" data-field="category" />
      </view>
      <view class="form-row">
        <text class="form-label">商家</text>
        <input class="input" type="text" value="{{form.merchant}}" bindinput="onFieldInput" data-field="merchant" />
      </view>
      <view class="form-row">
        <text class="form-label">支付</text>
        <input class="input" type="text" value="{{form.pay_method}}" bindinput="onFieldInput" data-field="pay_method" />
      </view>
      <view class="form-row">
        <text class="form-label">时间</text>
        <input class="input" type="text" value="{{form.bill_time}}" bindinput="onFieldInput" data-field="bill_time" />
      </view>
      <view class="form-row form-row--top">
        <text class="form-label">备注</text>
        <textarea class="textarea" value="{{form.remark}}" bindinput="onFieldInput" data-field="remark" />
      </view>
    </view>

    <!-- 按钮组 (文字按钮 + 圆角按钮) -->
    <view class="actions">
      <button class="btn btn--ghost" disabled="{{saving}}" bindtap="reset">重新识别</button>
      <button class="btn" disabled="{{saving}}" bindtap="save">{{saving ? '保存中 …' : '保存入册'}}</button>
    </view>
  </block>
</view>
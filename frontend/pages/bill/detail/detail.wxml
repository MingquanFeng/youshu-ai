<view class="page">
  <!-- 状态条 -->
  <view wx:if="{{loading}}" class="state-bar state-bar--loading">载入中 …</view>
  <view wx:elif="{{notFound}}" class="state-bar state-bar--error">此条记录不存在或已删除</view>
  <view wx:elif="{{errorMsg}}" class="state-bar state-bar--error">{{errorMsg}}</view>

  <block wx:elif="{{bill}}">
    <!-- 顶部: 单条信息 -->
    <view class="topbar">
      <view class="row gap-3" style="align-items: center;">
        <view class="topbar__icon" style="background: var(--cat-{{bill.category_key}}-soft);">
          <text class="topbar__icon-char">{{bill.category_char || '?'}}</text>
        </view>
        <view class="col">
          <text class="topbar__merchant">{{bill.merchant || bill.category || '—'}}</text>
          <text class="muted" style="font-size: 22rpx;">{{bill.bill_time_short}} · {{bill.source === 'image_ai' ? 'AI 识别' : '手动'}}</text>
        </view>
      </view>
    </view>

    <!-- 大金额 card (Modern Soft) -->
    <view class="amount-card">
      <text class="label">金额</text>
      <text class="amount-md">¥ {{bill.amount_str}}</text>
      <view class="row gap-2 amount-card__meta-row">
        <view class="chip chip--food">
          <view class="chip__dot"></view>
          <text>{{bill.category}}</text>
        </view>
        <text class="muted" style="font-size: 22rpx;">·</text>
        <text class="muted" style="font-size: 22rpx;">{{bill.pay_method || '未指定'}}</text>
      </view>
      <view wx:if="{{bill.remark}}" class="amount-card__remark">{{bill.remark}}</view>
    </view>

    <!-- 编辑表单 (card 化) -->
    <view class="form-card">
      <text class="label">编辑</text>
      <view class="form-row">
        <text class="form-label">金额</text>
        <input class="input" type="digit" value="{{form.amount}}" bindinput="onAmountInput" />
      </view>
      <view class="form-row">
        <text class="form-label">分类</text>
        <input class="input" type="text" value="{{form.category}}" bindinput="onFieldInput" data-field="category" />
      </view>
      <view class="form-row">
        <text class="form-label">商家</text>
        <input class="input" type="text" value="{{form.merchant}}" bindinput="onFieldInput" data-field="merchant" />
      </view>
      <view class="form-row form-row--top">
        <text class="form-label">备注</text>
        <textarea class="textarea" value="{{form.remark}}" bindinput="onFieldInput" data-field="remark" />
      </view>
    </view>

    <!-- 按钮组 -->
    <view class="actions">
      <button class="btn btn--danger-soft" disabled="{{saving}}" bindtap="confirmDelete">删除</button>
      <button class="btn" disabled="{{saving}}" bindtap="save">{{saving ? '保存中 …' : '保存修订'}}</button>
    </view>
  </block>
</view>
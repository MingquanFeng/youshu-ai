<view class="page">
  <!-- 加载 / 错误 -->
  <view wx:if="{{loading}}" class="state-bar state-bar--loading">载入中 …</view>
  <view wx:elif="{{notFound}}" class="state-bar state-bar--error">此条记录不存在或已删除</view>
  <view wx:elif="{{errorMsg}}" class="state-bar state-bar--error">{{errorMsg}}</view>

  <block wx:elif="{{bill}}">
    <!-- 报头 -->
    <view class="detail-head">
      <view class="row between">
        <text class="label">单条 · N° {{bill.id}}</text>
        <text class="label muted">{{bill.source === 'image_ai' ? 'AI 识别' : '手动'}}</text>
      </view>
      <text class="amount-xl detail-head__amount">¥ {{bill.amount_str}}</text>
      <text class="h2 detail-head__merchant">{{bill.merchant || bill.category || '—'}}</text>
      <text class="mono dim detail-head__time">{{bill.bill_time_short}}</text>
      <view class="hairline--thick"></view>
    </view>

    <!-- 信息卡 -->
    <view class="info-card">
      <view class="info-row">
        <text class="label">分类</text>
        <view class="chip chip--accent">{{bill.category}}</view>
      </view>
      <view class="info-row">
        <text class="label">支付</text>
        <text class="value ink">{{bill.pay_method || '—'}}</text>
      </view>
      <view class="info-row">
        <text class="label">备注</text>
        <text class="value dim">{{bill.remark || '—'}}</text>
      </view>
    </view>

    <!-- 编辑章节 -->
    <view class="chapter chapter--sub">
      <text class="h3">修订</text>
    </view>
    <view class="hairline"></view>

    <view class="form">
      <view class="form-row">
        <text class="form-label">金额</text>
        <input class="input" type="digit" value="{{form.amount}}" bindinput="onAmountInput" />
      </view>
      <view class="form-row">
        <text class="form-label">分类</text>
        <input class="input" type="text" value="{{form.category}}" bindinput="onFieldInput" data-field="category" />
      </view>
      <view class="form-row">
        <text class="form-label">商家</text>
        <input class="input" type="text" value="{{form.merchant}}" bindinput="onFieldInput" data-field="merchant" />
      </view>
      <view class="form-row form-row--top">
        <text class="form-label">备注</text>
        <textarea class="textarea" value="{{form.remark}}" bindinput="onFieldInput" data-field="remark" />
      </view>
    </view>

    <view class="actions">
      <button class="btn btn--danger" disabled="{{saving}}" bindtap="confirmDelete">删除</button>
      <button class="btn" disabled="{{saving}}" bindtap="save">{{saving ? '保存中 …' : '保存修订'}}</button>
    </view>
  </block>
</view>
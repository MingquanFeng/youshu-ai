/* bill/detail — 单条详情 (Long Document / Newsprint) */

.page {
  padding: var(--space-5) var(--space-4) var(--space-7);
  min-height: 100vh;
}

/* 报头：金额 + 商家 */
.detail-head {
  margin-bottom: var(--space-4);
}
.detail-head__amount {
  font-size: var(--text-4xl);
  margin: var(--space-3) 0 var(--space-2);
  letter-spacing: -0.04em;
}
.detail-head__merchant {
  font-family: var(--font-display);
  font-size: var(--text-xl);
  font-weight: 700;
  color: var(--color-ink);
  margin-bottom: var(--space-1);
  letter-spacing: -0.02em;
}
.detail-head__time {
  font-size: var(--text-sm);
  color: var(--color-ink-3);
  letter-spacing: var(--tracking-wide);
  text-transform: uppercase;
}

/* 信息卡 */
.info-card {
  background: var(--color-paper-2);
  border-top: var(--border-thick);
  border-bottom: var(--border-thick);
  padding: var(--space-3) 0;
  margin: var(--space-3) 0 var(--space-5);
}
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-2) var(--space-3);
}
.value {
  font-size: var(--text-md);
  font-weight: 500;
  color: var(--color-ink);
}

/* Chapter */
.chapter { margin-top: var(--space-6); margin-bottom: var(--space-3); }
.chapter--sub { margin-top: var(--space-5); }

/* Form */
.form { margin: var(--space-3) 0 var(--space-5); }
.form-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-2);
}
.form-row--top { align-items: flex-start; }
.form-label {
  width: 120rpx;
  flex-shrink: 0;
  font-family: var(--font-label);
  font-size: var(--text-xs);
  letter-spacing: var(--tracking-wide);
  text-transform: uppercase;
  color: var(--color-ink-3);
}
.form-row .input,
.form-row .textarea { flex: 1; min-width: 0; }
.form-row .textarea { min-height: 120rpx; }

/* Actions */
.actions {
  display: flex;
  gap: var(--space-3);
  margin-top: var(--space-5);
}
.actions .btn { flex: 1; min-width: 0; }
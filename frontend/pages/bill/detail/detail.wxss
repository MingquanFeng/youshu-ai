/* bill/detail — Modern Soft v6 + 编辑完整化 (校验/dirty/loading/错误) */

/* Page wrapper */
.page {
  padding: var(--space-5) var(--space-5) var(--space-7);
  background: var(--color-bg);
  color: var(--color-fg);
}

/* 大金额 card: 字号比首页小 (次要展示) */
.amount-card .amount-md {
  font-family: var(--font-mono);
  color: var(--color-primary);
  font-variant-numeric: tabular-nums;
  line-height: 1;
  font-size: 56rpx;
  font-weight: 600;
  margin-top: var(--space-3);
  letter-spacing: -0.02em;
  display: block;
}
.amount-card__meta-row {
  margin-top: var(--space-3);
  display: flex;
  align-items: center;
  gap: var(--space-2);
  flex-wrap: wrap;
}
.amount-card__pay {
  font-size: 24rpx;
  color: var(--color-fg-2);
}
.amount-card__remark {
  font-size: 24rpx;
  color: var(--color-fg-2);
  margin-top: var(--space-3);
  line-height: 1.6;
}

/* topbar 紧凑: icon 左 + 信息列右, 强制 row 覆盖公共 column */
.topbar {
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  gap: var(--space-3) !important;
  margin-bottom: var(--space-5) !important;
}
.topbar__icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--cat-other-soft);
  box-shadow: var(--shadow-sm);
}
.topbar__icon-char {
  font-family: var(--font-display);
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-fg);
  line-height: 1;
}
.topbar__info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.topbar__merchant {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-fg);
  line-height: 1.2;
  letter-spacing: -0.01em;
}
.topbar__meta {
  font-size: 24rpx;
  color: var(--color-fg-2);
  line-height: 1.3;
}
.form-card .label { margin-bottom: var(--space-3); }
.form-row {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
  padding: var(--space-2) 0;
  border-bottom: 1rpx solid var(--color-border-2);
}
.form-row:last-child { border-bottom: none; }
.form-label {
  width: 100rpx;
  flex-shrink: 0;
  color: var(--color-fg-2);
  font-size: var(--text-sm);
  padding-top: 18rpx;  /* align with input vertical center */
}
.form-row .input,
.form-row .textarea,
.form-row .form-picker {
  flex: 1;
  min-width: 0;
  border: 1rpx solid var(--color-border);
  background: var(--color-bg-2);
  padding: 12rpx 18rpx;
  font-family: inherit;
  font-size: var(--text-md);
  color: var(--color-fg);
  border-radius: var(--radius-sm);
  transition: border-color var(--dur-base) var(--ease-out),
              box-shadow var(--dur-base) var(--ease-out);
  box-sizing: border-box;
}
.form-row .input:focus,
.form-row .textarea:focus {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 4rpx rgba(16, 185, 129, 0.12);
  outline: none;
}
.form-row .textarea {
  min-height: 120rpx;
  line-height: 1.55;
  resize: vertical;
}
.form-row .input[disabled],
.form-row .textarea[disabled] {
  background: var(--color-bg-3);
  color: var(--color-fg-3);
  cursor: not-allowed;
}

/* picker 包装 (label 与 input 同样式) */
.form-picker__inner {
  display: block;
  min-height: 40rpx;
}

/* 字段错误态 */
.form-row--error .input,
.form-row--error .textarea,
.form-row--error .form-picker {
  border-color: var(--color-error);
  box-shadow: 0 0 0 4rpx rgba(239, 68, 68, 0.10);
}
.form-error {
  font-size: 22rpx;
  color: var(--color-error);
  margin-top: 6rpx;
  font-weight: 500;
}

/* state-bar 加 action 槽位 + sticky 变体 */
.state-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
}
.state-bar--sticky {
  position: sticky;
  top: 0;
  z-index: 10;
  margin: calc(var(--space-5) * -1) calc(var(--space-5) * -1) var(--space-3);
  border-radius: 0;
}
.state-bar__msg {
  flex: 1;
  min-width: 0;
}
.state-bar__action {
  font-size: 26rpx;
  font-weight: 600;
  opacity: 0.7;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: opacity var(--dur-fast) var(--ease-out);
}
.state-bar__action:active { opacity: 1.0; }

/* 删除按钮 (软) */
.btn--danger-soft {
  background: var(--color-error-soft);
  color: var(--color-error);
  border: none;
  box-shadow: var(--shadow-sm);
}
.btn--danger-soft[disabled] {
  background: var(--color-bg-3);
  color: var(--color-fg-3);
  box-shadow: none;
}

/* 保存按钮 spinner (text-only 旋转指示) */
.btn-spinner {
  display: inline-block;
  margin-right: 8rpx;
  font-size: 28rpx;
  animation: btn-spin 0.9s linear infinite;
}
@keyframes btn-spin {
  to { transform: rotate(360deg); }
}

/* actions 间距 */
.actions {
  display: flex;
  gap: var(--space-3);
  margin-top: var(--space-3);
}
.actions .btn { flex: 1; min-width: 0; }

/* 方向切换 (支出/收入) — pill 按钮组 */
.dir-toggle {
  flex: 1;
}
.dir-btn {
  flex: 1;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: var(--radius-pill);
  background: var(--color-bg-3);
  color: var(--color-fg-2);
  font-size: var(--text-sm);
  font-weight: 500;
  transition: all var(--dur-fast) var(--ease-out);
}
.dir-btn--active.dir-btn--expense {
  background: var(--color-primary);
  color: #fff;
  box-shadow: 0 2rpx 6rpx rgba(16, 185, 129, 0.25);
}
.dir-btn--active.dir-btn--income {
  background: var(--color-warning);
  color: #fff;
  box-shadow: 0 2rpx 6rpx rgba(245, 158, 11, 0.25);
}
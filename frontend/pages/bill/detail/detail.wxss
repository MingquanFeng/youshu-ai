/* bill/detail — Modern Soft v6
 * 全部样式提取到 app.wxss (topbar, amount-card, form-card, form-row, chip, actions 共用)
 * 这里只保留 .page 容器特化 + 详情页特殊样式
 */

.page {
  padding: var(--space-5) var(--space-5) var(--space-7);
  background: var(--color-bg);
  color: var(--color-fg);
}

/* 大金额 card — 用主色翠绿 */
.amount-card .amount-md {
  font-family: var(--font-mono);
  color: var(--color-primary);
  font-variant-numeric: tabular-nums;
  line-height: 1;
  font-size: 80rpx;
  font-weight: 600;
  margin-top: var(--space-3);
  letter-spacing: -0.02em;
}

/* 分类 chip + 支付方式同行 */
.amount-card__meta-row {
  margin-top: var(--space-3);
}

/* 备注文字 */
.amount-card__remark {
  font-size: 24rpx;
  color: var(--color-fg-2);
  margin-top: var(--space-3);
  line-height: 1.6;
}

/* 删除按钮改成 ghost-danger (软) */
.btn--danger-soft {
  background: var(--color-error-soft);
  color: var(--color-error);
  border: none;
  box-shadow: var(--shadow-sm);
}
.btn--danger-soft:hover, .btn--danger-soft.is-hover {
  background: var(--color-error);
  color: #FFFFFF;
}
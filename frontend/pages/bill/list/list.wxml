<view class="page">
  <!-- 顶部 header: 月份 + 统计 -->
  <view class="topbar">
    <text class="topbar__month">7月</text>
    <text class="muted" style="font-size: 22rpx;">共 {{total}} 笔</text>
  </view>

  <!-- 当月统计 card -->
  <view class="stat">
    <view class="row between">
      <view class="stat__left">
        <text class="label">本月支出</text>
        <text class="stat__amount">¥ 9,414.00</text>
      </view>
      <view class="stat__right">
        <text class="stat__label-pair">收入</text>
        <text class="stat__income-value">+¥ 22,000</text>
      </view>
    </view>
  </view>

  <!-- 流水 list (card 容器) -->
  <section-card>
    <view class="row between section-head">
      <text class="h4">所有流水</text>
      <text class="section-head__sub">按时间倒序</text>
    </view>

    <!-- 初次加载 skeleton -->
    <view wx:if="{{ items.length === 0 && loading }}">
      <view wx:for="{{ [0,1,2,3,4] }}" wx:key="*this" class="skel-row">
        <view class="skel skel--circle" style="width: 64rpx; height: 64rpx;"></view>
        <view class="skel-row__col" style="gap: 10rpx;">
          <view class="skel skel--md" style="width: 40%;"></view>
          <view class="skel skel--sm"></view>
        </view>
        <view class="skel" style="width: 100rpx; height: 26rpx;"></view>
      </view>
    </view>

    <view wx:elif="{{items.length > 0}}">
      <txn-row
        wx:for="{{items}}"
        wx:key="id"
        icon-bg="{{item.icon_bg}}"
        icon-char="{{item.icon_char}}"
        title="{{item.merchant || item.category}}"
        sub="{{item.bill_time_short}} · {{item.pay_method}}"
        amount="{{item.amount_sign}}"
        amount-style="{{item.amount_color}}"
        handler="onItemTap"
        data-item="{{item}}"
        bind:tap="onTxnTapWithItem"
      />
    </view>

    <view wx:elif class="empty">
      <view class="empty__icon"></view>
      <text class="empty__title">还没有记录</text>
      <text class="empty__hint">从一笔记账开始</text>
    </view>
  </section-card>

  <!-- 加载更多 / 到底提示 -->
  <view wx:if="{{items.length > 0}}" class="ledger-foot">
    <text wx:if="{{loading}}" class="muted" style="font-size: 22rpx;">加载中 …</text>
    <text wx:elif="{{!hasMore}}" class="muted" style="font-size: 22rpx;">— 已经到底 —</text>
    <text wx:elif="{{hasMore}}" class="muted" style="font-size: 22rpx;">↑ 上拉加载更多</text>
  </view>

  <!-- 错误条 -->
  <view wx:if="{{errorMsg}}" class="state-bar state-bar--error">{{errorMsg}}</view>

  <!-- 3-tab 底部导航 -->
  <tabbar active="{{ 1 }}" items="{{ tabs }}" bind:select="onTabSelect" />

  <!-- FAB -->
  <fab handler="goRecognize" bind:tap="onFabTap" />
</view>
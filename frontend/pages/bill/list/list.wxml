<view class="page">
  <!-- 错误条 -->
  <view wx:if="{{errorMsg}}" class="error-bar">
    <text class="error-text">{{errorMsg}}</text>
  </view>

  <!-- 列表 -->
  <block wx:if="{{items.length > 0}}">
    <view wx:for="{{items}}" wx:key="id" class="item" bindtap="onItemTap" data-item="{{item}}">
      <view class="item-left">
        <text class="merchant">{{item.merchant || item.category}}</text>
        <view class="meta-row">
          <text class="badge">{{item.category}}</text>
          <text class="meta-time">{{item.bill_time_short}}</text>
        </view>
        <text class="source-tag">{{item.source === 'image_ai' ? '🤖 AI 识别' : '✍️ 手动'}}</text>
      </view>
      <text class="amount">¥ {{item.amount_str}}</text>
    </view>
  </block>

  <!-- 空态 -->
  <view wx:elif="{{!loading}}" class="empty">
    <text class="empty-text">暂无账单</text>
    <button class="empty-btn" bindtap="goRecognize">去记一笔 →</button>
  </view>

  <!-- 底部 -->
  <view class="footer">
    <text wx:if="{{loading}}" class="footer-text">加载中…</text>
    <text wx:elif="{{!hasMore && items.length > 0}}" class="footer-text">- 已经到底啦 -</text>
    <text wx:elif="{{hasMore}}" class="footer-text">上拉加载更多</text>
  </view>
</view>
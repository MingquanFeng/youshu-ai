/* bill/list — Modern Soft v6
 * 全部样式提取到 app.wxss (stat, section, txn, tabbar, fab 共用)
 * 这里只保留 .page 容器特化
 */

.page {
  padding: var(--space-5) var(--space-5) 220rpx;
  background: var(--color-bg);
  color: var(--color-fg);
}

.topbar {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
}

/* Stat card (本月支出) — 大数字 + 收入辅助 */
.stat__amount {
  font-family: var(--font-mono);
  font-size: 56rpx;
  font-weight: 600;
  color: var(--color-fg);
  line-height: 1.05;
  margin-top: 8rpx;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
}
.stat__label-pair {
  font-size: 22rpx;
  color: var(--color-fg-2);
}
.stat__income-value {
  font-family: var(--font-mono);
  font-size: var(--text-md);
  font-weight: 500;
  color: var(--color-success);
  font-variant-numeric: tabular-nums;
}

/* section-head 副标题 */
.section-head__sub {
  font-size: 22rpx;
  color: var(--color-fg-3);
}

/* Empty 圆形占位 */
.empty__icon {
  background: var(--color-bg-3);
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin: 0 auto var(--space-3);
  box-shadow: var(--shadow-sm);
}

/* ledger-foot 加载更多 */
.ledger-foot {
  text-align: center;
  padding: var(--space-3) 0;
}
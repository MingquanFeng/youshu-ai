/* bill/list — 账本主页 (Long Document / Newsprint) */

.page {
  padding: var(--space-5) var(--space-4) var(--space-7);
  min-height: 100vh;
}

/* 报头 */
.ledger-head {
  margin-bottom: var(--space-3);
}
.ledger-head__title {
  font-size: var(--text-4xl);
  margin: var(--space-2) 0;
  letter-spacing: -0.04em;
}

/* 账本条目 */
.ledger {
  background: var(--color-paper-2);
  border-top: 2rpx solid var(--color-ink);
  border-bottom: 2rpx solid var(--color-ink);
}

.ledger-row {
  display: flex;
  align-items: stretch;
  padding: var(--space-3) var(--space-3);
  border-bottom: 1rpx solid var(--color-rule);
  transition: background-color var(--dur-base) var(--ease-out);
  gap: var(--space-3);
}
.ledger-row:last-child { border-bottom: none; }
.ledger-row--hover { background: var(--color-paper); }

/* 左侧：日期 + 分类 */
.ledger-row__date {
  display: flex;
  flex-direction: column;
  justify-content: center;
  width: 180rpx;
  flex-shrink: 0;
  gap: var(--space-1);
}
.ledger-row__date-num {
  font-size: var(--text-md);
  color: var(--color-ink);
  font-weight: 600;
}
.ledger-row .chip {
  align-self: flex-start;
}

/* 中间：商家 + meta */
.ledger-row__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: var(--space-1);
}
.ledger-row__merchant {
  font-family: var(--font-display);
  font-size: var(--text-md);
  font-weight: 600;
  color: var(--color-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ledger-row__meta {
  font-size: var(--text-xs);
  color: var(--color-ink-3);
  letter-spacing: var(--tracking-wide);
  text-transform: uppercase;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 右侧：金额（大字号 monospace） */
.ledger-row__amount {
  display: flex;
  align-items: baseline;
  gap: var(--space-1);
  flex-shrink: 0;
}
.ledger-row__amount .amount-lg { font-size: var(--text-lg); color: var(--color-ink-3); font-weight: 400; }
.ledger-row__amount .amount-xl { font-size: var(--text-2xl); color: var(--color-ink); }

/* 脚 */
.ledger-foot {
  text-align: center;
  padding: var(--space-5) 0;
  border-top: 1rpx solid var(--color-rule);
}
<view class="tabbar">
  <view
    wx:for="{{ items }}"
    wx:key="label"
    class="tab {{ active === index ? 'tab--active' : '' }}"
    data-index="{{ index }}"
    data-handler="{{ item.handler }}"
    bindtap="onTap"
  >
    <text class="tab__icon">{{ item.icon }}</text>
    <text class="tab__label">{{ item.label }}</text>
  </view>
</view>
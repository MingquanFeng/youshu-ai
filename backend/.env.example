# 应用配置
APP_NAME=youshu-ai
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# JWT
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# 数据库（dev 用 SQLite，生产改 PostgreSQL）
DATABASE_URL=sqlite:///./youshu_ai.db

# 微信小程序
WX_APP_ID=
WX_APP_SECRET=

# ===== AI 模型 (开发期默认 mock, 生产填 key 自动切真模型) =====
# 三层 pipeline: OCR (文本) → VISION (多模态直接读图) → LLM (校验/分类)
# 任何一层依赖缺失/Key 未填, 自动降级 mock + warning log, 不中断请求。
#
# 切真模型步骤:
#   1. pip install -e ".[ai]"     # 装 dashscope / openai (openai 兼容 MiniMax)
#   2. 改下面 BACKEND 字段
#   3. 填对应 API_KEY
#
# OCR_BACKEND: paddleocr (本地推理, 需 paddlepaddle, 不需 key)
# VISION_BACKEND: qwen-vl (阿里云百炼) | minimax (MiniMax-VL, OpenAI 兼容)
# LLM_BACKEND: deepseek | minimax (OpenAI 兼容)
OCR_BACKEND=mock           # paddleocr | mock
VISION_BACKEND=mock        # qwen-vl | minimax | mock
LLM_BACKEND=mock           # deepseek | minimax | mock

DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=

# MiniMax: 一个 key 覆盖 vision + llm (OpenAI 兼容协议, 用现有 openai 包)
# 推荐: VISION_BACKEND=minimax + LLM_BACKEND=minimax, 只填 MINIMAX_API_KEY 一项
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_VL_MODEL=MiniMax-01-Vis-32k
MINIMAX_TEXT_MODEL=MiniMax-Text-01
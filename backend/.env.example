# 应用配置
APP_NAME=youshu-ai
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# JWT
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# 数据库（dev 用 SQLite，生产改 PostgreSQL）
DATABASE_URL=sqlite:///./youshu_ai.db

# 微信小程序
WX_APP_ID=
WX_APP_SECRET=

# AI 模型
OCR_BACKEND=paddleocr     # paddleocr | mock
VISION_BACKEND=qwen-vl    # qwen-vl | mock
LLM_BACKEND=deepseek      # deepseek | mock
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
